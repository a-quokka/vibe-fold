---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FolderStack from '../components/FolderStack.astro';
import HomeIntro from '../components/HomeIntro.astro';
import ClubMark from '../components/ClubMark.astro';
import { getAllVolumes } from '../lib/content';

/** Only what is out. Volumes still being made have a folder design of their own
 *  — a blank tab that answers "Coming soon" when the trailing edge is pointed
 *  at, see FolderStack — but an empty drawer standing in front of the one
 *  volume there is says less than the volume does. Drop the filter to put them
 *  back. */
const volumes = getAllVolumes().filter((volume) => volume.status === 'published');
---

<BaseLayout title="Vibe Fold" bodyClass="page-home">
	<div class="home">
		<SiteHeader tagline={false} />

		<section class="slogan" aria-label="Vibe Fold">
			<h1 class="slogan__text">We publish visual stories that move the world</h1>

		</section>

		<FolderStack volumes={volumes} id="featured" />

		{/* Whose archive this is. It used to be printed in the corner of the
		    frontmost cover, where it belonged to one volume rather than to the
		    site; at the foot of the page it signs the whole drawer. */}
		<footer class="home__foot">
			<ClubMark />
		</footer>

		<HomeIntro />

	</div>
</BaseLayout>

<style>
	/* One continuous white page — atmosphere is only a top wash, not a section box */
	.home {
		position: relative;
		min-height: 100svh;
		/* Held to 1440px and centred. The dark ground still runs edge to edge —
		   it is painted on the body — so what the cap holds is the measure, not
		   the backdrop. */
		max-width: var(--w-max);
		margin-inline: auto;
		background: var(--color-bg);
	}







	/* dissolve atmosphere into the page white — no section edge */

	.slogan {
		position: relative;
		z-index: 1;
		background: transparent;
	}

	/* The page opens on the tagline alone, centred in the first screenful. */
	.slogan {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: var(--space-slogan-min-h);
		padding: var(--h-header) var(--page-pad) 1rem;
	}

	/* Matches the reference: 11x19, centred, 21px off the bottom, and static —
	   a looping bounce here would run for the whole time the page is open. */




	.home__foot {
		display: flex;
		justify-content: center;
		/* 40px off the foot of the page, centred across its whole measure. */
		padding: var(--space-hero-gap) var(--page-pad) 2.5rem;
		/* It signs the page; it does not announce it. */
		color: var(--color-text);
		opacity: 0.45;
	}

	.slogan__text {
		max-width: var(--measure-slogan);
		font-size: var(--text-slogan);
		font-weight: 400;
		line-height: 1.1;
		letter-spacing: -0.02em;
		text-align: center;
		text-wrap: balance;
	}

	/* No narrow-screen variant: the tagline sits on the centre line at every
	   width, and the room it reserves now comes down with its own type size —
	   see `--space-slogan-min-h` in global.css. */
</style>
