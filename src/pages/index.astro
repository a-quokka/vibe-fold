---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FolderStack from '../components/FolderStack.astro';
import HomeIntro from '../components/HomeIntro.astro';
import FolderReturn from '../components/FolderReturn.astro';
import WorkRail from '../components/WorkRail.astro';
import JoinCta from '../components/JoinCta.astro';
import { chapterHref, getAllVolumes, onShelf } from '../lib/content';

/** Everything in the drawer, made or being made.
 *
 *  A volume still being worked on is worth standing up — somebody looking at
 *  this should be able to see that there is more coming, and what it is going
 *  to be. What it cannot do is open: the cover carries no link and the tab no
 *  unfold, so a folder with nothing in it is a thing to look at, not a door
 *  that leads nowhere. Where they stand is set by `shelf` in each volume.yaml,
 *  which keeps the published one facing the room. */
const everything = getAllVolumes();

/** 서랍에는 선반에 있는 볼륨만 섭니다. 내려둔 볼륨은 폴더로 세우지
 *  않습니다. */
const volumes = everything.filter(onShelf);

/** 검색에 걸리는 문구.
 *
 *  제목과 설명은 화면에 보이지 않지만 검색 결과에서는 이 두 줄이 사이트의
 *  얼굴입니다. 한국어로 적습니다 — 한국 사람이 한국어로 찾을 때 걸려야
 *  하고, 영어 한 줄만 적어 두면 어느 쪽으로도 걸리지 않습니다. */
const pageTitle = '바이브 폴더 — 매달 새로운 주제로 실험하는 인터랙션 웹 프로젝트';
const pageDescription =
	'바이브 코딩 클럽이 매달 새로운 주제로 만드는 인터랙션 웹 프로젝트를 모아 둔 아카이브입니다. 설화·전설·신화를 인터랙티브 비주얼 스토리로 다시 엮은 작품들을 볼 수 있습니다.';

/** 기계가 읽는 같은 이야기. 사이트가 무엇을 모아 둔 곳이고, 그 안에 어떤
 *  작품이 누구 손으로 들어 있는지 적습니다. 나와 있는 볼륨의 작품만
 *  싣습니다 — 아직 없는 페이지를 가리키면 로봇이 404 를 받습니다. */
const works = everything
	.filter((volume) => volume.status === 'published')
	.flatMap((volume) =>
		volume.chapters.map((chapter) => ({
			'@type': 'CreativeWork',
			name: chapter.title,
			url: new URL(chapterHref(volume.volId, chapter.chId), Astro.site).href,
			description: chapter.description.replace(/\s+/g, ' ').trim(),
			author: { '@type': 'Person', name: chapter.creator },
			thumbnailUrl: new URL(chapter.thumbSrc, Astro.site).href,
			inLanguage: 'ko',
		})),
	);

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: '바이브 폴더',
	alternateName: 'Vibe Fold',
	url: new URL('/', Astro.site).href,
	description: pageDescription,
	inLanguage: 'ko',
	publisher: {
		'@type': 'Organization',
		name: 'Vibe Coding Club',
		alternateName: '바이브 코딩 클럽',
		url: 'https://vibecodingclub.kr',
	},
	hasPart: works,
};
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	bodyClass="page-home"
	jsonLd={jsonLd}
>
	<div class="home">
		{/* Ahead of everything it hides.
		    Whether the page is being come back to is settled by a script, and a
		    script settles it where it stands: put at the foot of the page, it is
		    reached after the drawer has been parsed, and the browser is free to
		    paint a finished stack in the meantime — which showed as the folder
		    flashing once before the way back took it. Up here it runs before
		    there is a drawer to paint. It also has to come before HomeIntro,
		    which stands down when it finds the flag this sets. */}
		<FolderReturn phase="claim" />

		<SiteHeader tagline={false} />

		{/* 무엇을 만드는 곳인지 먼저 말하고, 만든 것을 바로 밑에 펼칩니다. */}
		<section class="slogan" aria-label="Vibe Fold">
			{/* 줄바꿈은 브라우저가 고르게 두지 않고 여기서 못 박습니다. 두 줄이
			    각각 하나의 뜻을 이루고 있어서, 폭에 따라 다른 자리에서 접히면
			    문장이 다르게 읽힙니다.
			    좁은 화면에서는 뜻이 한 자리 더 나뉩니다 — 쉼표 뒤에서 한 번
			    더 끊어 무엇을 만드는 곳인지와 그 이름을 각각 한 줄로
			    세웁니다. 그 줄바꿈은 좁을 때만 섭니다. */}
			<h1 class="slogan__text">
				매달 새로운 주제로 실험하는<br />인터랙션 웹 프로젝트,<br class="slogan__turn" /> 바이브 폴더
			</h1>
		</section>

		{/* 카드로 늘어놓는 것은 저장소에 있는 작품 전부입니다. 폴더에서
		    내려둔 볼륨의 작품도 만들어진 작품이므로 걸어 둡니다. 다만 볼륨이
		    나오지 않았으면 열어 볼 자리가 없어서 링크는 걸리지 않습니다. */}
		<section class="curation" aria-label="Works">
			<WorkRail volumes={everything} />
		</section>

		{/* 서랍에 이름을 붙입니다. 카드 줄과 서랍은 둘 다 작품을 보여 주지만
		    하는 일이 다릅니다: 위는 최근 것을 꺼내 보이는 자리이고, 아래는
		    지나간 것까지 모아 둔 자리입니다. 그 경계에 이름이 없으면 같은
		    것이 두 번 나오는 것으로 읽힙니다.

		    스크롤이 여기에 닿으면 나타납니다. 화면에 들어온 것을 아는 방법은
		    `IntersectionObserver` 입니다. 스크롤 이벤트로 세면 손가락이
		    움직이는 내내 계산이 돌아 화면이 버벅입니다. */}
		<header class="archive" data-archive>
			<h2 class="archive__title">프로젝트 아카이브</h2>
		</header>

		<FolderStack volumes={volumes} id="featured" />

		{/* The instant the drawer exists and not a moment later — see the note in
		    the component. The copy of the folder being brought home has to be on
		    the screen in the page's first frame, or it blinks out across the
		    change of page and back in again. */}
		<FolderReturn phase="carry" />

		{/* 들어오는 문. 페이지 흐름에 자리를 두지 않습니다 — 화면 발치에
		    붙어 늘 떠 있으므로, 여기에 자리까지 잡으면 같은 것이 두 번
		    섭니다. */}
		<JoinCta />

		<footer class="home__foot">
			{/* 누가 만든 곳인지와 어디에서 더 볼 수 있는지. 주소는 클럽
			    사이트에 걸린 것을 그대로 씁니다 — 같은 곳을 가리키는 링크가
			    두 사이트에서 다르면 둘 중 하나는 반드시 낡습니다. */}
			<div class="foot">
				<p class="foot__rights">© 2025 Vibe Coding Club. All rights reserved.</p>

				<ul class="foot__links">
					<li>
						<a href="https://github.com/vibe-ai-coding-club" target="_blank" rel="noreferrer">
							GitHub
						</a>
					</li>
					<li>
						<a href="https://www.linkedin.com/groups/17438022" target="_blank" rel="noreferrer">
							LinkedIn
						</a>
					</li>
					<li>
						<a href="https://www.instagram.com/vibe.coding.club/" target="_blank" rel="noreferrer">
							Instagram
						</a>
					</li>
				</ul>
			</div>
		</footer>

		<HomeIntro />

	</div>
</BaseLayout>

<style>
	/* One continuous white page — atmosphere is only a top wash, not a section box */
	.home {
		position: relative;
		min-height: 100svh;
		/* Held to 1440px and centred. The dark ground still runs edge to edge —
		   it is painted on the body — so what the cap holds is the measure, not
		   the backdrop. */
		max-width: var(--w-max);
		margin-inline: auto;
		background: var(--color-bg);
	}







	/* dissolve atmosphere into the page white — no section edge */

	/* 서랍의 이름. 페이지 가운데에 한 줄로 섭니다 — 슬로건도 카드도 가운데에
	   서 있어서, 이 이름만 왼쪽에 붙으면 줄이 어긋나 보입니다. */
	.archive {
		display: flex;
		justify-content: center;
		padding: 0 var(--page-pad);
		margin-bottom: clamp(1rem, 1.5vw, 1.25rem);
		text-align: center;
	}

	.archive__title {
		margin: 0;
		/* 순백입니다. 페이지의 글자색(`--color-text`)은 따뜻한 쪽으로 기운
		   흰색(#f7f4ef)인데, 이 제목은 서랍의 이름이라 한 단 밝게 세웁니다. */
		color: #ffffff;
		/* 넓은 화면에서 40px 까지 커집니다. 히어로의 슬로건(1280px 에서 49px)
		   보다는 작게 둡니다 — 페이지에서 가장 큰 글자는 무엇을 만드는 곳인지
		   말하는 첫 문장이어야 하고, 이것은 그 아래에 놓인 서랍의 이름입니다. */
		font-size: clamp(1.375rem, 3.2vw, 2.5rem);
		font-weight: 500;
		line-height: 1.2;
		letter-spacing: -0.01em;
		white-space: nowrap;
		/* 들어오기 전. 조금 아래에서 올라옵니다. */
		opacity: 0;
		translate: 0 1.25rem;
		transition-property: opacity, translate;
		transition-duration: 560ms;
		transition-timing-function: var(--ease-out);
	}

	/* 글자를 하나씩 쪼개 둔 뒤에는 제목 자체가 움직이지 않습니다. 올라오는
	   일은 글자들이 맡고, 제목은 자리만 지킵니다. 쪼개기는 스크립트가 하므로
	   스크립트가 돌지 않으면 위의 통째로 올라오는 모습이 그대로 남습니다. */
	.archive__title[data-split] {
		opacity: 1;
		translate: 0;
		transition: none;
	}

	/* 글자마다 제 몸을 가리는 상자를 하나씩 씌웁니다. 글자는 그 상자 밖에서
	   시작해 안으로 올라오므로, 아무것도 없는 데서 켜지는 것이 아니라 제 줄
	   아래에서 밀려 올라오는 것으로 보입니다. */
	/* 상자는 스크립트가 만듭니다. Astro 는 이 파일의 규칙에 제 표시를 달아
	   같은 표시가 붙은 요소에만 적용하는데, 그 표시는 서버에서 찍어 낸
	   마크업에만 붙습니다 — 그래서 나중에 만든 상자에는 `:global` 로
	   적어 주어야 규칙이 닿습니다. */
	.archive__title :global(.archive__char) {
		display: inline-block;
		overflow: hidden;
		vertical-align: bottom;
	}

	.archive__title :global(.archive__char > span) {
		display: inline-block;
		translate: 0 105%;
		opacity: 0;
		/* 뒤 글자일수록 늦게 출발합니다. 한 글자당 52ms — 일곱 글자가 다
		   올라오는 데 3분의 1초 남짓 걸리는 속도입니다. */
		transition-property: translate, opacity;
		transition-duration: 720ms, 420ms;
		transition-timing-function: var(--ease-out);
		transition-delay: calc(var(--i, 0) * 52ms);
		will-change: transform;
	}

	.archive[data-seen] .archive__title :global(.archive__char > span) {
		translate: 0 0;
		opacity: 1;
	}

	.archive[data-seen] .archive__title {
		opacity: 1;
		translate: 0 0;
	}

	/* 움직임을 줄이는 환경에서는 올라오는 것을 걷고 켜지기만 합니다. 이름이
	   붙는다는 사실은 그대로 남습니다. */
	@media (prefers-reduced-motion: reduce) {
		.archive__title {
			translate: 0;
			transition-duration: 240ms;
		}

		/* 글자를 하나씩 밀어 올리는 대신 한꺼번에 켭니다. 줄줄이 움직이는
		   것이 부담인 환경에서는 그 줄줄이가 곧 부담이기 때문입니다. */
		.archive__title :global(.archive__char > span) {
			translate: 0;
			transition-property: opacity;
			transition-duration: 240ms;
			transition-delay: 0ms;
		}

	}

	/* 슬로건과 카드 사이 90px, 카드와 서랍 사이 60px. 카드 줄은 기운 만큼을
	   이미 제 안으로 당겨 두었으므로, 여기 적는 값이 곧 눈에 보이는 간격
	   입니다. 아래쪽은 서랍이 제 머리에 이고 있는 여백만큼 덜어 냅니다 —
	   두 값을 그냥 더하면 간격이 두 번 들어갑니다. */
	.curation {
		position: relative;
		z-index: 1;
		padding-top: calc(90px + var(--rail-over-top));
		padding-bottom: max(
			0px,
			calc(24px + var(--rail-over-bot) - var(--space-hero-gap) - var(--tab-height))
		);
	}

	/* 좁은 화면에서는 카드와 제목 사이를 좁힙니다. 부채가 작아지면 가운데
	   카드 아래로 바깥 카드들이 내려앉는 깊이도 함께 줄어드는데, 넓은
	   화면에 맞춰 둔 여백은 그대로 남아 가운데 카드 밑이 통째로 비어
	   보였습니다. 아래위로 20px 만 남기고, 제목이 이고 있던 여백도
	   줄입니다. */
	@media (max-width: 48rem) {
		/* 좁은 화면에서는 사이를 전반적으로 좁힙니다. 넓은 화면에서 쓰는
		   여백을 그대로 두면, 한 화면에 한 덩어리씩만 들어와서 무엇과 무엇이
		   한 묶음인지가 스크롤 사이로 흩어집니다. */
		.curation {
			padding-top: calc(48px + var(--rail-over-top));
			padding-bottom: max(
				0px,
				calc(6px + var(--rail-over-bot) - var(--space-hero-gap) - var(--tab-height))
			);
		}

		.archive {
			margin-bottom: 0.5rem;
		}

		/* 슬로건 위로 한 뼘 더. 머리글 바로 밑에서 시작하면 첫 줄이 머리글에
		   얹힌 것처럼 보입니다. 넓은 화면에서는 슬로건이 화면 가운데에 서서
		   위아래로 저절로 여백을 갖지만, 좁은 화면에서는 세 줄이 위쪽에
		   붙어 서기 때문에 그 여백을 직접 줘야 합니다.
		   `.home` 을 앞에 적는 이유는 발치와 같습니다 — 슬로건의 본 규칙이
		   이 아래에 있고 거기서 `padding` 을 한 번에 적으므로, 같은 무게로는
		   위쪽 값이 집니다. */
		.home .slogan {
			padding-top: calc(var(--h-header) + 2rem);
		}

		/* 서랍과 발치 사이. 넓은 화면의 100px 은 분홍 색면과 서랍 사이로
		   검은 바탕을 한 뼘 보이게 하려는 값인데, 좁은 화면에서는 그 한 뼘이
		   화면의 8분의 1 입니다.
		   `.home` 을 앞에 적어 둡니다 — 이 규칙이 발치의 본 규칙보다 위에
		   있어서, 같은 무게로는 아래쪽 100px 에 집니다. */
		.home .home__foot {
			margin-top: 56px;
		}
	}

	.slogan {
		position: relative;
		z-index: 1;
		background: transparent;
	}

	/* 낱말 안에서는 접지 않습니다. 한국어는 글자마다 접을 수 있어서, 그냥
	   두면 "바이브 폴더" 가 "바이브 폴"/"더" 로 갈라집니다 — 접히는 자리는
	   낱말 사이여야 합니다. */
	:global(.slogan__text) {
		word-break: keep-all;
	}

	/* 쉼표 뒤의 줄바꿈. 넓을 때는 서 있지 않습니다.
	 *
	 * 594px 에서 갈립니다. 글자 크기가 `clamp(1.625rem, 7.4vw, 2.75rem)` 이라
	 * 그 아래에서는 폭과 함께 커지는데, 둘째 줄은 글자 크기의 12.19배가
	 * 필요하고 좌우 여백을 뺀 자리는 폭의 0.896배뿐입니다 — 어느 폭에서도
	 * 두 줄로는 들어가지 않습니다. 2.75rem 이 7.4vw 와 같아지는 폭이
	 * 594px(37.125rem)이고, 그 위로는 글자가 더 커지지 않으므로 두 줄이
	 * 제자리를 찾습니다. */
	:global(.slogan__turn) {
		display: none;
	}

	@media (max-width: 37.125rem) {
		:global(.slogan__turn) {
			display: inline;
		}
	}

	/* 한 화면을 통째로 쓰던 자리였습니다. 그때는 이 상자 안에 작품을 흩어
	   두었으므로 그만한 높이가 필요했습니다. 이제 작품은 아래의 제 줄에
	   서므로, 여기 남는 것은 문장 한 줄이 설 자리뿐입니다. 위쪽은 머리글이
	   쓰는 높이만큼 비웁니다. */
	.slogan {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: calc(var(--h-header) + clamp(0.5rem, 1.2vw, 1.125rem)) var(--page-pad)
			clamp(0.25rem, 1vw, 0.75rem);
	}

	/* Matches the reference: 11x19, centred, 21px off the bottom, and static —
	   a looping bounce here would run for the whole time the page is open. */




	.home__foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		/* 서랍과 발치 사이 100px. 발치가 색을 갖게 되면서 서랍에 바로 붙으면
		   두 색면이 맞닿아 경계가 사납습니다. 그 사이로 페이지의 검은 바탕이
		   한 뼘 보이게 둡니다. */
		margin-top: 100px;
		/* 서랍에서 폴더가 밀려 내려간 만큼 발치도 같이 내려갑니다. 폴더가
		   움직이는 것과 같은 속도, 같은 곡선으로 따라가야 둘이 한 몸으로
		   움직이는 것으로 보입니다. */
		translate: 0 var(--drawer-push, 0px);
		transition: translate var(--folder-duration) var(--folder-ease);
		/* 위쪽은 40px. 아래쪽은 떠 있는 참여하기가 서는 높이만큼 더 비웁니다 —
		   그러지 않으면 서명이 단추에 영영 가립니다. */
		padding: clamp(1.5rem, 2.6vw, 2.25rem) var(--page-pad) 7.5rem;
		/* 페이지 발치를 분홍 한 장으로 덮습니다. 어두운 페이지가 여기서
		   끝난다는 것을 색으로 말합니다. */
		background: var(--color-foot);
		/* 색지에는 검은 잉크입니다. 이 분홍은 서랍의 색지와 같은 밝은
		   분홍이어서 흰 글자가 얹히지 않습니다. */
		color: var(--color-foot-ink);
	}

	/* 잉크를 그대로 씁니다. 옅게 만들면 분홍과 섞여 분홍빛 회색이 되는데,
	   그것은 옅은 검정이 아니라 바랜 분홍으로 보입니다. */
	.foot {
		opacity: 1;
	}

	/* 서명 아래 한 줄. 왼쪽에 누가 만들었는지, 오른쪽에 어디에서 더 볼 수
	   있는지. 좁은 화면에서는 둘을 세로로 쌓습니다 — 나란히 두기에는 줄이
	   길어서 양쪽이 서로 밀어냅니다. */
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		width: 100%;
		font-size: var(--text-meta);
	}

	.foot__rights {
		margin: 0;
	}

	.foot__links {
		display: flex;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* 손이 닿았을 때 글자를 옅게 만들지 않습니다. 글자를 묽히면 닿은 링크가
	   닿지 않은 링크보다 읽기 어려워집니다. 밑줄로 답합니다 — 색을 쓰지
	   않는 신호라 밝기차가 그대로 남습니다. */
	.foot__links a {
		color: inherit;
		text-decoration: none;
		text-decoration-color: currentColor;
		text-underline-offset: 0.25em;
		transition: text-decoration-color 160ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.foot__links a:hover {
			text-decoration: underline;
		}
	}

	.foot__links a:active {
		text-decoration: underline;
	}

	@media (max-width: 40rem) {
		.foot {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.875rem;
		}
	}

	/* 흩어 놓은 그림들 위에 글자가 놓입니다. 겹치는 자리에서 글자가 그림에
	   묻히지 않도록, 글자 쪽을 앞에 세우고 옅은 그늘을 깔아 둡니다. */
	.slogan__text {
		position: relative;
		z-index: 1;
		text-shadow: 0 1px 14px var(--color-bg);
	}

	.slogan__text {
		/* 히어로 한 줄만 손글씨로 둡니다. 나머지는 전부 본문 글꼴입니다. */
		font-family: 'HS Summer Water', var(--font-sans);
		max-width: var(--measure-slogan);
		font-size: var(--text-slogan);
		font-weight: 400;
		/* 200%. 두 줄 사이를 한 줄만큼 비워 두면 각 줄이 제 문장으로
		   떨어져 읽힙니다. */
		line-height: 2;
		letter-spacing: -0.02em;
		text-align: center;
		text-wrap: balance;
	}

	/* No narrow-screen variant: the tagline sits on the centre line at every
	   width, and the room it reserves now comes down with its own type size —
	   see `--space-slogan-min-h` in global.css. */
</style>

<script>
	/* 화면에 들어오면 한 번만 켭니다. 켠 뒤에는 관찰을 멈춥니다: 스크롤을
	   오르내릴 때마다 이름이 나타났다 사라지면, 자리를 알려 주는 표시가
	   아니라 깜박이는 장식이 됩니다. */
	const archive = document.querySelector<HTMLElement>('[data-archive]');
	const archiveTitle = archive?.querySelector<HTMLElement>('.archive__title') ?? null;

	/* 제목을 글자 하나씩으로 쪼개 둡니다.
	 *
	 *  쪼개는 일은 마크업이 아니라 여기에서 합니다. 마크업에서 쪼개 두면
	 *  읽어 주는 기계에는 낱글자 일곱 개가 따로따로 읽히고, 긁어서 복사해도
	 *  글자마다 끊깁니다. 올라오는 동안만 쪼개 두고 끝나면 도로 한 줄의
	 *  글월로 돌려놓습니다 — HomeIntro 가 슬로건에 하는 것과 같은 이유이고
	 *  같은 방법입니다.
	 *
	 *  띄어쓰기는 상자를 씌우지 않고 그대로 둡니다. 빈칸에 상자를 씌우면
	 *  줄 끝에서 접히는 자리가 달라집니다. */
	const splitChars = (element: HTMLElement): (() => void) => {
		const source = element.textContent ?? '';
		element.textContent = '';

		let index = 0;
		for (const glyph of Array.from(source)) {
			if (/\s/.test(glyph)) {
				element.append(glyph);
				continue;
			}

			const mask = document.createElement('span');
			mask.className = 'archive__char';
			mask.style.setProperty('--i', String(index));
			const inner = document.createElement('span');
			inner.textContent = glyph;
			mask.append(inner);
			element.append(mask);
			index += 1;
		}

		element.dataset.split = '';

		// 다 올라오고 나면 도로 한 줄의 글월로 돌려놓습니다. 쪼개 둔 동안은
		// 글자마다 제 상자를 쓰고 있어서, 긁어 보면 낱글자가 따로따로
		// 잡힙니다.
		return () => {
			element.textContent = source;
			delete element.dataset.split;
		};
	};

	if (archive) {
		let restore: (() => void) | null = null;
		let count = 0;

		if (archiveTitle) {
			count = Array.from(archiveTitle.textContent ?? '').filter((glyph) => !/\s/.test(glyph)).length;
			restore = splitChars(archiveTitle);
		}

		const watcher = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					archive.dataset.seen = '';
					watcher.disconnect();
					// 마지막 글자가 출발하는 시각에 그 글자가 올라오는 데
					// 걸리는 시간을 더하고, 넉넉히 한 번 더 기다린 뒤에
					// 되돌립니다. 켜기 전에 되돌리면 올라올 글자가 없습니다.
					window.setTimeout(() => restore?.(), count * 52 + 720 + 400);
				}
			},
			// 제목이 화면 바닥에 걸치자마자가 아니라, 충분히 올라온 뒤에
			// 켭니다. 바닥에서 켜면 올라오는 동작을 눈이 놓칩니다.
			{ threshold: 0.6 },
		);

		watcher.observe(archive);
	}
</script>
