---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import FolderStack from '../components/FolderStack.astro';
import HomeIntro from '../components/HomeIntro.astro';
import FolderReturn from '../components/FolderReturn.astro';
import WorkRail from '../components/WorkRail.astro';
import JoinCta from '../components/JoinCta.astro';
import { getAllVolumes, onShelf } from '../lib/content';

/** Everything in the drawer, made or being made.
 *
 *  A volume still being worked on is worth standing up — somebody looking at
 *  this should be able to see that there is more coming, and what it is going
 *  to be. What it cannot do is open: the cover carries no link and the tab no
 *  unfold, so a folder with nothing in it is a thing to look at, not a door
 *  that leads nowhere. Where they stand is set by `shelf` in each volume.yaml,
 *  which keeps the published one facing the room. */
const everything = getAllVolumes();

/** 서랍에는 선반에 있는 볼륨만 섭니다. 내려둔 볼륨은 폴더로 세우지
 *  않습니다. */
const volumes = everything.filter(onShelf);
---

<BaseLayout title="Vibe Fold" bodyClass="page-home">
	<div class="home">
		{/* Ahead of everything it hides.
		    Whether the page is being come back to is settled by a script, and a
		    script settles it where it stands: put at the foot of the page, it is
		    reached after the drawer has been parsed, and the browser is free to
		    paint a finished stack in the meantime — which showed as the folder
		    flashing once before the way back took it. Up here it runs before
		    there is a drawer to paint. It also has to come before HomeIntro,
		    which stands down when it finds the flag this sets. */}
		<FolderReturn phase="claim" />

		<SiteHeader tagline={false} />

		{/* 무엇을 만드는 곳인지 먼저 말하고, 만든 것을 바로 밑에 펼칩니다. */}
		<section class="slogan" aria-label="Vibe Fold">
			{/* 줄바꿈은 브라우저가 고르게 두지 않고 여기서 못 박습니다. 두 줄이
			    각각 하나의 뜻을 이루고 있어서, 폭에 따라 다른 자리에서 접히면
			    문장이 다르게 읽힙니다. */}
			<h1 class="slogan__text">
				매달 새로운 주제로 실험하는<br />인터랙션 웹 프로젝트, 바이브 폴더
			</h1>
		</section>

		{/* 카드로 늘어놓는 것은 저장소에 있는 작품 전부입니다. 폴더에서
		    내려둔 볼륨의 작품도 만들어진 작품이므로 걸어 둡니다. 다만 볼륨이
		    나오지 않았으면 열어 볼 자리가 없어서 링크는 걸리지 않습니다. */}
		<section class="curation" aria-label="Works">
			<WorkRail volumes={everything} />
		</section>

		<FolderStack volumes={volumes} id="featured" />

		{/* The instant the drawer exists and not a moment later — see the note in
		    the component. The copy of the folder being brought home has to be on
		    the screen in the page's first frame, or it blinks out across the
		    change of page and back in again. */}
		<FolderReturn phase="carry" />

		{/* 들어오는 문. 페이지 흐름에 자리를 두지 않습니다 — 화면 발치에
		    붙어 늘 떠 있으므로, 여기에 자리까지 잡으면 같은 것이 두 번
		    섭니다. */}
		<JoinCta />

		<footer class="home__foot">
			{/* 누가 만든 곳인지와 어디에서 더 볼 수 있는지. 주소는 클럽
			    사이트에 걸린 것을 그대로 씁니다 — 같은 곳을 가리키는 링크가
			    두 사이트에서 다르면 둘 중 하나는 반드시 낡습니다. */}
			<div class="foot">
				<p class="foot__rights">© 2025 Vibe Coding Club. All rights reserved.</p>

				<ul class="foot__links">
					<li>
						<a href="https://github.com/vibe-ai-coding-club" target="_blank" rel="noreferrer">
							GitHub
						</a>
					</li>
					<li>
						<a href="https://www.linkedin.com/groups/17438022" target="_blank" rel="noreferrer">
							LinkedIn
						</a>
					</li>
					<li>
						<a href="https://www.instagram.com/vibe.coding.club/" target="_blank" rel="noreferrer">
							Instagram
						</a>
					</li>
				</ul>
			</div>
		</footer>

		<HomeIntro />

	</div>
</BaseLayout>

<style>
	/* One continuous white page — atmosphere is only a top wash, not a section box */
	.home {
		position: relative;
		min-height: 100svh;
		/* Held to 1440px and centred. The dark ground still runs edge to edge —
		   it is painted on the body — so what the cap holds is the measure, not
		   the backdrop. */
		max-width: var(--w-max);
		margin-inline: auto;
		background: var(--color-bg);
	}







	/* dissolve atmosphere into the page white — no section edge */

	/* 슬로건과 카드 사이 90px, 카드와 서랍 사이 60px. 카드 줄은 기운 만큼을
	   이미 제 안으로 당겨 두었으므로, 여기 적는 값이 곧 눈에 보이는 간격
	   입니다. 아래쪽은 서랍이 제 머리에 이고 있는 여백만큼 덜어 냅니다 —
	   두 값을 그냥 더하면 간격이 두 번 들어갑니다. */
	.curation {
		position: relative;
		z-index: 1;
		padding-top: calc(90px + var(--rail-over-top));
		padding-bottom: max(
			0px,
			calc(60px + var(--rail-over-bot) - var(--space-hero-gap) - var(--tab-height))
		);
	}

	.slogan {
		position: relative;
		z-index: 1;
		background: transparent;
	}

	/* 한 화면을 통째로 쓰던 자리였습니다. 그때는 이 상자 안에 작품을 흩어
	   두었으므로 그만한 높이가 필요했습니다. 이제 작품은 아래의 제 줄에
	   서므로, 여기 남는 것은 문장 한 줄이 설 자리뿐입니다. 위쪽은 머리글이
	   쓰는 높이만큼 비웁니다. */
	.slogan {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: calc(var(--h-header) + clamp(0.5rem, 1.2vw, 1.125rem)) var(--page-pad)
			clamp(0.25rem, 1vw, 0.75rem);
	}

	/* Matches the reference: 11x19, centred, 21px off the bottom, and static —
	   a looping bounce here would run for the whole time the page is open. */




	.home__foot {
		display: flex;
		flex-direction: column;
		align-items: center;
		/* 서랍과 발치 사이 100px. 발치가 색을 갖게 되면서 서랍에 바로 붙으면
		   두 색면이 맞닿아 경계가 사납습니다. 그 사이로 페이지의 검은 바탕이
		   한 뼘 보이게 둡니다. */
		margin-top: 100px;
		/* 서랍에서 폴더가 밀려 내려간 만큼 발치도 같이 내려갑니다. 폴더가
		   움직이는 것과 같은 속도, 같은 곡선으로 따라가야 둘이 한 몸으로
		   움직이는 것으로 보입니다. */
		translate: 0 var(--drawer-push, 0px);
		transition: translate var(--folder-duration) var(--folder-ease);
		/* 위쪽은 40px. 아래쪽은 떠 있는 참여하기가 서는 높이만큼 더 비웁니다 —
		   그러지 않으면 서명이 단추에 영영 가립니다. */
		padding: clamp(1.5rem, 2.6vw, 2.25rem) var(--page-pad) 7.5rem;
		/* 페이지 발치를 분홍 한 장으로 덮습니다. 어두운 페이지가 여기서
		   끝난다는 것을 색으로 말합니다. */
		background: var(--color-foot);
		/* 글자는 흰색입니다. 검은 잉크는 이 분홍 위에서 색과 비슷한 무게로
		   눌러앉아, 적어 둔 것이 아니라 얼룩처럼 보입니다. */
		color: #ffffff;
	}

	/* 흰 글자를 그대로 씁니다. 옅게 만들면 핫핑크와 섞여 분홍빛 회색이
	   되는데, 그것은 옅은 흰색이 아니라 탁한 분홍으로 보입니다. */
	.foot {
		opacity: 1;
	}

	/* 서명 아래 한 줄. 왼쪽에 누가 만들었는지, 오른쪽에 어디에서 더 볼 수
	   있는지. 좁은 화면에서는 둘을 세로로 쌓습니다 — 나란히 두기에는 줄이
	   길어서 양쪽이 서로 밀어냅니다. */
	.foot {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem 2rem;
		width: 100%;
		font-size: var(--text-meta);
	}

	.foot__rights {
		margin: 0;
	}

	.foot__links {
		display: flex;
		gap: clamp(1rem, 2.4vw, 2rem);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.foot__links a {
		color: inherit;
		text-decoration: none;
		transition: opacity 160ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.foot__links a:hover {
			opacity: 0.6;
		}
	}

	.foot__links a:active {
		opacity: 0.6;
	}

	@media (max-width: 40rem) {
		.foot {
			flex-direction: column;
			align-items: flex-start;
			gap: 0.875rem;
		}
	}

	/* 흩어 놓은 그림들 위에 글자가 놓입니다. 겹치는 자리에서 글자가 그림에
	   묻히지 않도록, 글자 쪽을 앞에 세우고 옅은 그늘을 깔아 둡니다. */
	.slogan__text {
		position: relative;
		z-index: 1;
		text-shadow: 0 1px 14px var(--color-bg);
	}

	.slogan__text {
		/* 히어로 한 줄만 손글씨로 둡니다. 나머지는 전부 본문 글꼴입니다. */
		font-family: 'HS Summer Water', var(--font-sans);
		max-width: var(--measure-slogan);
		font-size: var(--text-slogan);
		font-weight: 400;
		/* 200%. 두 줄 사이를 한 줄만큼 비워 두면 각 줄이 제 문장으로
		   떨어져 읽힙니다. */
		line-height: 2;
		letter-spacing: -0.02em;
		text-align: center;
		text-wrap: balance;
	}

	/* No narrow-screen variant: the tagline sits on the centre line at every
	   width, and the room it reserves now comes down with its own type size —
	   see `--space-slogan-min-h` in global.css. */
</style>
