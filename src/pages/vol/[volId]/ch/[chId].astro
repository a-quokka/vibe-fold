---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ChapterChrome from '../../../../components/ChapterChrome.astro';
import {
	formatChapterLabel,
	formatVolumeTitle,
	getAdjacentChapters,
	getAllVolumes,
	getVolumeByVolId,
} from '../../../../lib/content';

export function getStaticPaths() {
	return getAllVolumes()
		.filter((volume) => volume.status === 'published')
		.flatMap((volume) =>
			volume.chapters.map((chapter) => ({
				params: { volId: volume.volId, chId: chapter.chId },
			})),
		);
}

const { volId, chId } = Astro.params;
const volume = getVolumeByVolId(volId!);

if (!volume) {
	throw new Error(`Volume not found: ${volId}`);
}

const { current, prev, next } = getAdjacentChapters(volume, chId!);

if (!current) {
	throw new Error(`Chapter not found: ${volId}/${chId}`);
}

const pageTitle = `${formatChapterLabel(current.order, current.title)} · ${formatVolumeTitle(volume)}`;

/** 기계가 읽는 이 작품의 신원. 누가 만든 무엇이고 어느 볼륨에 들어 있는지
 *  적습니다. 검색 결과에 제목 한 줄만 나오는 대신 만든 사람과 그림이 함께
 *  붙는 것은 이 덕입니다. */
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CreativeWork',
	name: current.title,
	url: new URL(Astro.url.pathname, Astro.site).href,
	description: current.description.replace(/\s+/g, ' ').trim(),
	author: { '@type': 'Person', name: current.creator },
	thumbnailUrl: new URL(current.thumbSrc, Astro.site).href,
	inLanguage: 'ko',
	isPartOf: {
		'@type': 'CollectionPage',
		name: formatVolumeTitle(volume),
		url: new URL(`/vol/${volume.volId}/`, Astro.site).href,
	},
	publisher: {
		'@type': 'Organization',
		name: 'Vibe Coding Club',
		url: 'https://vibecodingclub.kr',
	},
};
---

<BaseLayout
	title={`${pageTitle} · Vibe Fold`}
	description={current.description}
	bodyClass="page-chapter"
	image={current.shareImageSrc}
	icon={current.faviconSrc}
	type="article"
	themeColor="#000000"
	jsonLd={jsonLd}
>
	<ChapterChrome volume={volume} prev={prev} next={next} />

	<main class="chapter-stage">
		<iframe
			class="chapter-stage__frame"
			src={current.iframeSrc}
			title={formatChapterLabel(current.order, current.title)}
			sandbox="allow-scripts"
			{/* The chapter is cross-origin to this page — it is sandboxed, so its
			    origin is opaque — and `autoplay` defaults to `self`. Without this
			    it may not sound at all: muted film plays, a voice never does, and
			    the refusal is silent. Delegated rather than assumed. */}
			allow="autoplay"
			loading="eager"
		></iframe>
	</main>
</BaseLayout>

<style>
	:global(body.page-chapter) {
		overflow: hidden;
		background: #000;
	}

	.chapter-stage {
		position: fixed;
		inset: 0;
		background: #000;
	}

	.chapter-stage__frame {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		background: #000;
	}
</style>
