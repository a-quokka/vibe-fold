---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import FolderOpening from '../../../components/FolderOpening.astro';
import {
	chapterHref,
	formatVolLabel,
	formatVolumeTitle,
	getAllVolumes,
	getVolumeByVolId,
} from '../../../lib/content';
import { swatchAt } from '../../../lib/palette';

export function getStaticPaths() {
	return getAllVolumes()
		.filter((volume) => volume.status === 'published')
		.map((volume) => ({
			params: { volId: volume.volId },
		}));
}

const { volId } = Astro.params;
const volume = getVolumeByVolId(volId!);

if (!volume) {
	throw new Error(`Volume not found: ${volId}`);
}

/** The page wears the colour of the folder that opened it, so arriving here
 *  reads as stepping inside that folder rather than as a separate screen. */
const all = getAllVolumes();
const swatch = swatchAt(volume.number);

const summaryParagraphs = volume.summary.split(/\n\n+/).filter(Boolean);
const title = volume.example ? `${volume.title} (Example)` : volume.title;

/** 기계가 읽는 이 볼륨의 신원. 한 주제 아래 묶인 작품 목록입니다. */
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: formatVolumeTitle(volume),
	url: new URL(Astro.url.pathname, Astro.site).href,
	description: volume.summary.replace(/\s+/g, ' ').trim(),
	inLanguage: 'ko',
	publisher: {
		'@type': 'Organization',
		name: 'Vibe Coding Club',
		url: 'https://vibecodingclub.kr',
	},
	hasPart: volume.chapters.map((chapter) => ({
		'@type': 'CreativeWork',
		name: chapter.title,
		url: new URL(chapterHref(volume.volId, chapter.chId), Astro.site).href,
		author: { '@type': 'Person', name: chapter.creator },
	})),
};
---

<BaseLayout
	title={`${formatVolumeTitle(volume)} · Vibe Fold`}
	description={volume.summary}
	bodyClass="page-volume"
	themeColor={swatch.bg}
	jsonLd={jsonLd}
>
	<div class="page" style={`--sheet: ${swatch.bg}; --ink: ${swatch.ink};`}>
		<SiteHeader tagline={false} />

		{/* Title sits on the dark, above the sheet — as in the reference. */}
		<header class="page__head">
			<p class="page__vol">{formatVolLabel(volume.number)}</p>
			<h1 class="page__title">{title}</h1>
		</header>

		<div
			class="volume"
			data-flip-id={`folder-${volume.volId}`}
		>
			<span
				class="volume__tab"
				aria-hidden="true"
				data-flip-id={`tab-${volume.volId}`}
			>
				{title}
			</span>

			<div class="volume__summary">
				{summaryParagraphs.map((paragraph) => <p>{paragraph}</p>)}
			</div>

		{
			volume.chapters.length === 0 ? (
				<p class="volume__empty">아직 공개된 작품이 없습니다.</p>
			) : (
				<div class="volume__body">
					<nav class="contents" aria-label={`${title} contents`}>
						<p class="contents__label">Contents</p>
						<ol class="contents__list">
							{volume.chapters.map((chapter, index) => (
								<li>
									<button class="contents__item" type="button" data-focus-work={index}>
										<span class="contents__num">{String(index + 1).padStart(2, '0')}</span>
										<span class="contents__title">{chapter.title}</span>
									</button>
								</li>
							))}
						</ol>
					</nav>

					{/* Cards are absolutely placed so dragging one never reflows the
					    others, and scattered by index so the pile looks handled. */}
					<div class="collage" data-stage>
						{volume.chapters.map((chapter, index) => (
							<a
								class="work"
								data-work={index}
								href={chapterHref(volume.volId, chapter.chId)}
								style={`--seed: ${index};`}
							>
								<img
									class="work__thumb"
									src={chapter.thumbSrc}
									alt=""
									loading="lazy"
									draggable="false"
								/>
								<div class="work__body">
									<p class="work__label">{`Ch.${chapter.order}`}</p>
									<h2 class="work__title">{chapter.title}</h2>
									<p class="work__desc">{chapter.description}</p>
								</div>
							</a>
						))}
					</div>

					<div class="volume__controls">
						<p class="volume__counter" aria-live="polite">
							<span data-counter-current>1</span> / {volume.chapters.length}
						</p>
						<button class="volume__next" type="button" data-next-work>
							Next
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="M4 12h15m-6.5-6.5L19 12l-6.5 6.5"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									stroke-linecap="round"
									stroke-linejoin="round"
								/>
							</svg>
						</button>
					</div>
				</div>
			)
		}
		</div>
	</div>

	{/* The page opens as the folder that was clicked, turning upright and
	    swinging its cover away; when it finishes it hands the screen to the
	    page above. */}
	<FolderOpening
		color={swatch.bg}
		ink={swatch.ink}
		label={formatVolLabel(volume.number)}
		flipId={`folder-${volume.volId}`}
		title={title}
		summary={summaryParagraphs}
		works={volume.chapters.map((chapter) => ({
			href: chapterHref(volume.volId, chapter.chId),
			label: `Ch.${chapter.order}`,
			title: chapter.title,
			thumb: chapter.thumbSrc,
		}))}
	/>

</BaseLayout>

<style>
	.page {
		min-height: 100svh;
		padding-bottom: var(--space-archive-y);
		background: var(--color-bg);
		color: var(--color-text);
	}

	.page__head {
		padding: calc(var(--h-header) + var(--space-hero-y)) var(--page-pad)
			clamp(1rem, 2.4vw, 2rem);
	}

	.page__vol {
		font-size: var(--text-meta);
		line-height: var(--lh-tight);
		color: var(--color-muted);
	}

	.page__title {
		margin: 0.375rem 0 0;
		font-size: var(--text-display);
		font-weight: 700;
		line-height: var(--lh-display);
	}

	/* The sheet bleeds off the leading edge and stops short of the trailing one,
	   leaving the dark strip the tab stands in — measured at ~78% of the width
	   in the reference. */
	.volume {
		position: relative;
		perspective: var(--folder-perspective);
		transform-style: preserve-3d;
		width: min(100%, 78%);
		min-height: 60svh;
		padding: clamp(1.5rem, 3vw, 2.5rem) 0 clamp(1.5rem, 3vw, 2.5rem);
		background: var(--sheet);
		color: var(--ink);
		border-radius: 0 var(--folder-radius) var(--folder-radius) 0;
	}

	/* The tab stands on the sheet's trailing edge, the quarter turn it finished
	   when the page opened. Same shoulder path as the stack's. */
	.volume__tab {
		position: absolute;
		top: clamp(1.5rem, 3vw, 2.5rem);
		left: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		height: var(--tab-height);
		min-width: 9rem;
		padding: 0 1rem;
		background: var(--sheet);
		color: var(--ink);
		font-size: var(--text-meta);
		white-space: nowrap;
		transform-origin: left top;
		rotate: 90deg;
		/* The shoulders are the stack tab's curve, rotated with it. */
		clip-path: polygon(0 0, 100% 0, 88% 100%, 12% 100%);
	}

	.volume__summary {
		display: grid;
		gap: 1em;
		/* The paper's own margins are the measure. There were two copies of this
		   block — one the transition draws and one the settled page draws — and a
		   width set on only one of them shows as the text reflowing the moment
		   the folder hands over. */
		padding: 0 var(--page-pad);
		font-size: var(--text-body);
		line-height: var(--lh-body);
	}

	.volume__empty {
		padding: var(--space-hero-y) var(--page-pad);
		font-size: var(--text-body);
		opacity: 0.8;
	}

	.volume__body {
		display: grid;
		grid-template-columns: minmax(0, 14rem) minmax(0, 1fr);
		gap: clamp(1.5rem, 3vw, 3rem);
		padding: clamp(1.5rem, 3vw, 3rem) var(--page-pad) 0;
	}

	.contents__label {
		margin-bottom: 0.75rem;
		font-size: var(--text-meta);
		letter-spacing: 0.08em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	.contents__list {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.contents__item {
		display: flex;
		gap: 0.625rem;
		width: 100%;
		padding: 0.4375rem 0.5rem;
		border: 0;
		border-radius: 0.1875rem;
		background: none;
		color: inherit;
		font: inherit;
		font-size: var(--text-meta);
		text-align: left;
		cursor: pointer;
		opacity: 0.7;
		transition-property: opacity, background-color;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
	}

	.contents__item:hover,
	.contents__item:focus-visible {
		opacity: 1;
		background: color-mix(in srgb, currentColor 12%, transparent);
	}

	.contents__item[data-active='true'] {
		opacity: 1;
		background: color-mix(in srgb, currentColor 20%, transparent);
	}

	.contents__num {
		flex: none;
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
	}

	.contents__title {
		min-width: 0;
		overflow-wrap: anywhere;
	}

	.collage {
		position: relative;
		min-height: clamp(28rem, 46vw, 38rem);
	}

	.work {
		position: absolute;
		top: calc(var(--seed) * 3rem);
		left: calc(var(--seed) * 12%);
		display: flex;
		flex-direction: column;
		width: min(17rem, 76%);
		rotate: calc((var(--seed) - 1.5) * 1.6deg);
		background: var(--color-card);
		color: var(--color-card-text);
		border-radius: 0.25rem;
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.2), 0 10px 28px rgb(0 0 0 / 0.24);
		overflow: hidden;
	}

	.work:focus-visible {
		outline: 3px solid var(--ink);
		outline-offset: 3px;
	}

	.work__thumb {
		display: block;
		width: 100%;
		height: clamp(8rem, 12vw, 10.5rem);
		object-fit: cover;
		object-position: center 30%;
		outline: 1px solid oklch(0 0 0 / 0.1);
		outline-offset: -1px;
		pointer-events: none;
	}

	.work__body {
		display: flex;
		flex-direction: column;
		gap: 0.3125rem;
		padding: 0.75rem 0.875rem 1rem;
	}

	.work__label {
		font-size: var(--text-meta);
		line-height: 1;
		color: var(--color-card-muted);
	}

	.work__title {
		margin: 0;
		font-size: var(--text-heading);
		font-weight: 700;
		line-height: var(--lh-tight);
	}

	.work__desc {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 3;
		line-clamp: 3;
		overflow: hidden;
		margin: 0;
		font-size: var(--text-meta);
		line-height: var(--lh-body);
		color: var(--color-card-muted);
	}

	.volume__controls {
		grid-column: 1 / -1;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-top: clamp(1rem, 2vw, 1.75rem);
	}

	.volume__counter {
		font-size: var(--text-meta);
		font-variant-numeric: tabular-nums;
		opacity: 0.8;
	}

	.volume__next {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.5rem 1rem;
		border: 1px solid color-mix(in srgb, currentColor 45%, transparent);
		border-radius: 999px;
		background: none;
		color: inherit;
		font: inherit;
		font-size: var(--text-meta);
		cursor: pointer;
		transition-property: background-color, scale;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
	}

	.volume__next svg {
		width: 1rem;
		height: 1rem;
	}

	.volume__next:active {
		scale: 0.96;
	}

	.volume__next:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 2px;
	}

	@media (hover: hover) and (pointer: fine) {
		.volume__next:hover {
			background: color-mix(in srgb, currentColor 16%, transparent);
		}
	}

	@media (max-width: 900px) {
		.volume__body {
			grid-template-columns: minmax(0, 1fr);
		}

		.work {
			left: calc(var(--seed) * 6%);
			width: min(15rem, 84%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.contents__item,
		.volume__next {
			transition: none;
		}

		.work {
			rotate: none;
		}
	}
</style>

<script>
	const stage = document.querySelector<HTMLElement>('[data-stage]');
	const works = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-work]'));
	const contents = Array.from(document.querySelectorAll<HTMLElement>('[data-focus-work]'));
	const counter = document.querySelector<HTMLElement>('[data-counter-current]');
	const nextButton = document.querySelector<HTMLButtonElement>('[data-next-work]');

	if (stage && works.length > 0) {
		let top = works.length;
		let active = 0;

		const bringToFront = (index: number) => {
			const work = works[index];
			if (!work) return;
			top += 1;
			work.style.zIndex = String(top);
			active = index;
			contents.forEach((item, i) => {
				item.dataset.active = String(i === index);
			});
			if (counter) counter.textContent = String(index + 1);
		};

		works.forEach((work, index) => {
			work.style.zIndex = String(index + 1);
		});
		bringToFront(0);

		contents.forEach((item, index) => {
			item.addEventListener('click', () => bringToFront(index));
		});

		nextButton?.addEventListener('click', () => bringToFront((active + 1) % works.length));

	}
</script>
