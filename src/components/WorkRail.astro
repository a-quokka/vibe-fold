		let slide = 0;

		/** 한 바퀴를 접어 −N/2 … N/2 안으로 넣습니다. 이 접히는 자리가 두 벌의
		 *  이음매이고, 화면 밖이라 보이지 않습니다. */
		const fold = (value: number) => ((((value + half) % count) + count) % count) - half;

