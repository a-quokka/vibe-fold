		const FAN_STEP = 9;
		/* 반지름은 카드 폭에 비례합니다. 1400px 은 카드가 512px(32rem)일 때의
		   값이고, 그 비율을 그대로 씁니다. 고정값으로 두었더니 좁은 화면에서
		   카드만 작아지고 내려앉는 깊이는 그대로여서, 가운데 카드 아래로
		   빈자리가 크게 남았습니다. 부채는 어느 크기에서나 같은 모양이어야
		   같은 부채로 보입니다. */
		const ARC_RATIO = 1400 / 512;
		let arcR = 1400;
		/* 부채에서 눈에 보이는 폭. 이보다 멀어진 카드는 꺼집니다 — 두 벌의
