			if (width > 0) arcR = width * ARC_RATIO;

			const height = cards[0]?.offsetHeight ?? 0;
			/* 눈에 보이는 가장 바깥 카드가 내려앉는 깊이. 그 아래로 한 뼘만
			   더 둡니다 — 여기 남는 만큼이 카드와 다음 줄 사이의 빈자리가
			   되므로, 어림한 값을 크게 잡아 둘 자리가 아닙니다. */
			const drop = (1 - Math.cos((2 * FAN_STEP * Math.PI) / 180)) * arcR;
			if (height > 0) rail.style.setProperty('--rail-h', `${Math.round(height + drop + 4)}px`);
		};

		/** 한 칸의 너비. `--rail-step` 이 카드 폭의 0.65 이므로 거기서 뽑습니다.
		 *  계산식으로 적힌 사용자 속성은 문자열로 돌아오므로 재서 씁니다. */
		const stride = () => (slots[0]?.offsetWidth ?? 1) * 0.65;

		/** 모든 자리를 지금의 기준에 맞춰 놓습니다. */
		const place = () => {
			const step = stride();
			slots.forEach((slot, i) => {
				const pos = fold(i - anchor - slide);
				const lean = pos * FAN_STEP;
				slot.style.setProperty('--x', `${(pos * step).toFixed(1)}px`);
				slot.style.setProperty(
					'--y',
					`${((1 - Math.cos((lean * Math.PI) / 180)) * arcR).toFixed(1)}px`,
				);
				slot.style.setProperty('--lean', `${lean.toFixed(2)}deg`);
				// 지금 몇 칸째에 서 있는지. 손 밑의 카드를 한가운데로 부를 때
				// 이 값을 그대로 씁니다.
				slot.dataset.pos = String(Math.round(pos));
				// 가운데가 맨 위에 있고 거기서 좌우로 한 장씩 밑으로 들어갑니다.
				//
				// 숫자를 배경 판(40)보다 낮게 둡니다. 높게 두었더니 카드가
				// 뒤집힐 때 깔리는 어두운 판이 나머지 카드 밑으로 들어가서,
				// 읽는 카드만 남기려던 판이 아무것도 가리지 못했습니다.
				slot.style.zIndex = String(Math.round(30 - Math.abs(pos) * 5));
				// 이음매가 지나가는 자리에서는 꺼 둡니다.
				const fade = 1 - (Math.abs(pos) - VISIBLE) / 0.8;
				slot.style.opacity = String(Math.max(0, Math.min(1, fade)));
			});
		};

		/* ── 들어올 때 ───────────────────────────────────────────────────
		 *
		 * 처음에는 다섯 장이 한가운데에 포개져 있습니다. 전환을 끈 채로 한 벌을
		 * 쌓아 두고, 다음 프레임에 전환을 켜면서 제자리를 알려 주면 거기서
		 * 풀려 나갑니다. 가운데 장이 먼저 떠나고 바깥 장이 나중에 떠납니다 —
		 * 손으로 부채를 펼 때 바깥 장이 마지막까지 남아 있는 것과 같습니다. */
		measure();
		rail.dataset.dragging = '';
		slots.forEach((slot) => {
			slot.style.setProperty('--x', '0px');
			slot.style.setProperty('--y', '0px');
			slot.style.setProperty('--lean', '0deg');
			slot.style.opacity = '0';
		});

		requestAnimationFrame(() => {
			requestAnimationFrame(() => {
				delete rail.dataset.dragging;
				rail.dataset.dealing = '';
				slots.forEach((slot, i) => {
					const pos = Math.abs(fold(i - home));
					slot.style.transitionDelay = `${Math.min(pos, 3) * 90}ms`;
				});
				place();
				// 가장 늦게 떠나는 장(270ms)이 다 도착하는 시각입니다. 그 뒤로는
				// 끌고 놓는 속도로 돌아갑니다.
				window.setTimeout(() => {
					delete rail.dataset.dealing;
					slots.forEach((slot) => {
						slot.style.transitionDelay = '';
					});
				}, 1150);
			});
		});

		/* ── 열린 카드 ───────────────────────────────────────────────────── */

		let open: HTMLElement | null = null;

		/** 카드를 화면 한가운데로 옮길 거리.
		 *
		 *  카드가 아니라 카드가 놓인 자리에서 잽니다. 카드는 기울어 있고 곧
		 *  확대까지 되므로 제 상자가 이미 비뚤어져 있습니다. 자리는 옮겨 놓기만
		 *  걸려 있어 똑바른 값을 돌려줍니다. */
		const centreOffset = (card: HTMLElement) => {
			const slot = card.parentElement;
			if (!slot) return { x: 0, y: 0 };
			const box = slot.getBoundingClientRect();
			return {
				x: Math.round(window.innerWidth / 2 - (box.left + box.width / 2)),
				y: Math.round(window.innerHeight / 2 - (box.top + box.height / 2)),
			};
		};

		/** 열려 있는 동안 페이지는 움직이지 않습니다. 옮길 거리를 누른 순간의
		 *  화면을 기준으로 쟀으므로, 그 아래에서 페이지가 흐르면 카드가
		 *  한가운데에서 미끄러집니다. */
		const lockPage = (locked: boolean) => {
			document.documentElement.style.overflow = locked ? 'hidden' : '';
			// 화면에 떠 있는 것들에게 카드가 열렸다고 알립니다. 지금은
			// 참여하기가 이 표를 보고 물러납니다.
			if (locked) document.documentElement.dataset.cardOpen = '';
			else delete document.documentElement.dataset.cardOpen;
		};

		const close = () => {
			if (!open) return;

			const card = open;
			open = null;

			delete card.dataset.open;
			card.style.removeProperty('--fx');
			card.style.removeProperty('--fy');
			// 쌓이는 차례를 부채의 것으로 돌려놓습니다.
			place();

			const front = card.querySelector<HTMLElement>('[data-open-card]');
			const back = card.querySelector<HTMLElement>('[data-back]');
			front?.setAttribute('aria-expanded', 'false');
			back?.setAttribute('inert', '');

			delete scrim.dataset.on;
			// 판이 다 사라진 뒤에 자리를 비웁니다. 곧바로 치우면 사라지는
			// 모습 없이 툭 꺼집니다.
			window.setTimeout(() => {
				if (!open) scrim.hidden = true;
			}, 260);

			lockPage(false);
			front?.focus();
		};

		const openCard = (card: HTMLElement) => {
			if (open === card) return;
			if (open) close();

			const { x, y } = centreOffset(card);
			card.style.setProperty('--fx', `${x}px`);
			card.style.setProperty('--fy', `${y}px`);
			card.dataset.open = '';
			open = card;

			/* 배경 판보다 위로 올립니다.
			 *
			 *  자리를 놓는 함수가 매번 z-index 를 인라인으로 적기 때문에,
			 *  CSS 규칙으로 올려 두어도 그 인라인 값에 눌립니다. 뒤집힌 카드가
			 *  제 배경 판 아래에 깔려 함께 어두워지던 것이 이것입니다. 같은
			 *  방식으로, 인라인으로 올려 줍니다. */
			if (card.parentElement) card.parentElement.style.zIndex = '80';

			const front = card.querySelector<HTMLElement>('[data-open-card]');
			const back = card.querySelector<HTMLElement>('[data-back]');
			front?.setAttribute('aria-expanded', 'true');
			back?.removeAttribute('inert');

			scrim.hidden = false;
			// 한 프레임 뒤에 켭니다. 같은 프레임에 자리를 만들고 불을 켜면
			// 브라우저가 처음부터 켜져 있던 것으로 보고 번지지 않습니다.
			requestAnimationFrame(() => {
				scrim.dataset.on = '';
			});

			// 뒤집힌 카드의 앞면은 보이지 않습니다. 보이지 않는 영상을 계속
			// 돌릴 이유가 없습니다.
			const clip = card.querySelector<HTMLVideoElement>('[data-clip]');
			if (clip) {
				delete clip.dataset.playing;
				clip.pause();
				clip.currentTime = 0;
			}

			lockPage(true);
			back?.focus({ preventScroll: true });
		};

		/* ── 고르는 방법 ─────────────────────────────────────────────────
		 *
		 * 한가운데에 세울 카드는 끌어서 고릅니다. 손을 놓으면 그 자리에서
		 * 가장 가까운 카드가 한가운데로 붙습니다.
		 *
		 * 가리키는 것으로도, 누르는 것으로도 돌게 해 보았으나 둘 다 걷었습니다.
		 * 가리켜 돌게 하면 가리킨 카드가 곧 움직여 버려 손이 늘 빗나간 카드
		 * 위에 남았고, 눌러 돌게 하면 뒤집으려고 누른 것인지 고르려고 누른
		 * 것인지가 카드의 자리에 따라 달라져서 같은 손짓이 두 가지 뜻을
		 * 가졌습니다. 끌기는 손이 움직인 만큼만 돌고, 누름은 언제나 뒤집기
		 * 하나입니다. */

		/* ── 끌기 ────────────────────────────────────────────────────── */

		let holding: number | null = null;
		let startX = 0;
		let moved = false;

		rail.addEventListener('pointerdown', (event) => {
			if (open || event.button !== 0) return;
			holding = event.pointerId;
			startX = event.clientX;
			moved = false;
		});

		rail.addEventListener('pointermove', (event) => {
			if (open) return;

			if (holding === event.pointerId) {
				const dx = event.clientX - startX;
				if (!moved && Math.abs(dx) > 6) {
					moved = true;
					rail.dataset.dragging = '';
					// 손가락이 줄 밖으로 나가도 계속 따라옵니다. 이미 놓인
					// 포인터면 붙잡을 것이 없으므로 조용히 넘깁니다.
					try {
						rail.setPointerCapture(event.pointerId);
					} catch {
						/* 붙잡을 포인터가 없습니다. */
					}
				}
				if (moved) {
					slide = -dx / stride();
					place();
				}
				return;
			}

		});

		const release = (event: PointerEvent) => {
			if (holding !== event.pointerId) return;
			holding = null;

			if (!moved) return;

			// 가장 가까운 카드에 붙여 세웁니다.
			anchor = anchor + Math.round(slide);
			slide = 0;
			delete rail.dataset.dragging;
			place();

			// 끌고 난 직후의 클릭은 카드를 여는 뜻이 아닙니다.
			window.setTimeout(() => {
				moved = false;
			}, 0);
		};

		rail.addEventListener('pointerup', release);
		rail.addEventListener('pointercancel', release);

		/* 손이 줄을 벗어나도 되돌리지 않습니다.
		 *
		 *  기본으로 되돌리던 것을 걷었습니다. 부채를 돌려 놓고 손을 떼면 곧장
		 *  처음 자리로 미끄러져서, 골라 둔 것이 남지 않았습니다. 볼륨이 제
		 *  표지로 고른 작품은 처음 들어왔을 때 한 번 한가운데에 서는 것으로
		 *  족하고, 그 뒤로는 읽는 사람이 세워 둔 자리가 유지됩니다. */

		/* ── 미리보기 영상 ──────────────────────────────────────────────
		 *
		 * 손이 올라간 카드에 영상이 딸려 있으면 그것을 돌립니다.
		 *
		 * 자동 재생은 소리가 없을 때만 허용됩니다. 손이 올라간 것은 브라우저가
		 * 세는 「사용자가 한 행동」이 아니기 때문에, 소리가 있으면 재생이
		 * 조용히 거부됩니다. 그래서 언제나 음소거로 돌립니다.
		 *
		 * 손이 떠나면 멈추고 처음으로 되감습니다. 되감지 않으면 다음에 다시
		 * 가리켰을 때 지난번에 멈춘 자리에서 이어져, 같은 카드가 볼 때마다
		 * 다른 장면으로 시작합니다.
		 *
		 * 재생 요청은 거부될 수 있습니다(자동 재생 정책, 파일 오류). 그래서
		 * 실제로 돌기 시작한 뒤에야 `data-playing` 을 붙이고, 화면은 그
		 * 표를 보고 영상을 띄웁니다. 붙지 않으면 그림 한 장 그대로입니다. */
		const gentle = window.matchMedia('(prefers-reduced-motion: reduce)');
		const fine = window.matchMedia('(hover: hover) and (pointer: fine)');

		cards.forEach((card) => {
			const clip = card.querySelector<HTMLVideoElement>('[data-clip]');
			if (!clip) return;

			card.addEventListener('pointerenter', () => {
				if (open || gentle.matches || !fine.matches) return;
				clip.play().then(
					() => {
						clip.dataset.playing = '';
					},
					() => {
						/* 브라우저가 거부했습니다. 그림 한 장으로 둡니다. */
					},
				);
			});

			card.addEventListener('pointerleave', () => {
				delete clip.dataset.playing;
				clip.pause();
				clip.currentTime = 0;
			});
		});

		/* ── 카드 열고 닫기 ─────────────────────────────────────────────── */

		cards.forEach((card) => {
			card.querySelector<HTMLElement>('[data-open-card]')?.addEventListener('click', () => {
				// 끌고 난 직후의 클릭은 뒤집으려는 뜻이 아닙니다.
				if (moved) return;
				openCard(card);
			});

			card.querySelector<HTMLElement>('[data-close-card]')?.addEventListener('click', close);
		});

		scrim.addEventListener('click', close);

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && open) close();
		});

		/** 창 크기가 바뀌면 한 칸의 너비도 한가운데도 옮겨 갑니다. 부채를 다시
		 *  놓고, 열려 있는 카드가 있으면 그 거리도 다시 잽니다. */
		window.addEventListener('resize', () => {
			measure();
			place();
			if (!open) return;
			const { x, y } = centreOffset(open);
			open.style.setProperty('--fx', `${x}px`);
			open.style.setProperty('--fy', `${y}px`);
		});
	}
</script>
