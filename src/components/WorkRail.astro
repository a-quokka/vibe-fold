		const half = count / 2;

		/** 기본으로 한가운데 서는 자리. 볼륨이 제 표지로 고른 작품입니다. */
		const home = Number(rail.dataset.home ?? 0);

		/** 끌어서 돌린 만큼 눌러앉은 값. 손이 떠나면 기본으로 돌아갑니다. */
		let anchor = home;
