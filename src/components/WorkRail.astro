---
/** 작품 큐레이션.
 *
 *  페이지를 여는 자리에 작품을 카드로 늘어놓습니다. 서랍은 닫힌 표지의
 *  줄이라서 안에 무엇이 들었는지 한마디도 하지 않으므로, 들어온 사람이
 *  폴더를 열어 봐야 작품이 있다는 사실을 알게 됩니다. 이 페이지가 해야 할
 *  일은 보자마자 만들고 싶어지게 만드는 것이니 순서가 거꾸로입니다.
 *
 *  ── 왜 한 줄로 기울여 겹치는가
 *
 *  카드를 똑바로 세워 나란히 놓으면 표가 됩니다. 몇 장인지 세어지고, 다섯
 *  장은 다섯 장으로 끝납니다. 같은 방향으로 기울여 서로 겹쳐 놓으면 눈이
 *  셀 수 없고, 양 끝이 화면 밖으로 잘려 나가면 화면 너머에도 이어진다고
 *  읽습니다. 실제로 이 아래에 서랍이 있으니 거짓말도 아닙니다.
 *
 *  ── 카드는 두 면을 가진 물건입니다
 *
 *  앞면은 그림과 제목, 뒷면은 그 작품의 이야기입니다. 눌리면 그 카드가
 *  화면 한가운데로 옮겨 오면서 뒤로 돌아섭니다. 새 화면을 띄우지 않는
 *  이유는, 누른 것과 읽는 것이 같은 물건이라는 사실이 끊기지 않아야
 *  하기 때문입니다. 뒤집히는 것은 진짜 회전입니다 — 앞뒤 두 장을 겹쳐
 *  두고 `rotateY` 로 돌립니다.
 */
import type { Volume } from '../lib/content';
import { chapterHref, formatVolLabel } from '../lib/content';
import { fade, swatchAt } from '../lib/palette';

interface Props {
	volumes: Volume[];
}

const { volumes } = Astro.props;

const works = volumes.flatMap((volume) =>
	volume.chapters.map((chapter) => ({
		chapter,
		volume,
		/** 볼륨이 아직 나오지 않았다면 열어 볼 자리가 없습니다. 그때는 카드를
		 *  걸어 두기만 하고 어디로도 보내지 않습니다. */
		href: volume.status === 'published' ? chapterHref(volume.volId, chapter.chId) : null,
	})),
);

/** 카드 바탕이 도는 차례입니다.
 *
 *  전부 흰 종이면 줄이 한 장처럼 붙어 버리고, 전부 색이면 아래의 서랍과
 *  싸웁니다. 흰 종이와 색지와 검은 판을 돌려 쓰면 겹친 자리마다 경계가
 *  서고, 색은 서랍에서 쓰는 팔레트에서 그대로 가져오므로 두 영역이 한
 *  집안으로 읽힙니다. */
type Face = 'paper' | 'tint' | 'ink';

/** 색지 셋과 어두운 판 둘로 갑니다. 다섯 장이 모두 색을 가지면 줄이
 *  알록달록한 무늬가 되어 눈이 쉴 자리가 없고, 어두운 판을 사이사이에
 *  두면 색지끼리 서로를 밀어내지 않습니다.
 *
 *  어두운 판을 받는 것은 해와 달이 된 오누이와 도깨비입니다. 하나는 밤
 *  장면이고 하나는 흰 크롬으로 주조한 오브제라, 둘 다 어두운 판 위에서
 *  가장 크게 살아납니다. */
const FACES: Face[] = ['tint', 'ink', 'tint', 'ink', 'tint'];

/** 색지에 쓸 색을 작품마다 지정합니다. 번호는 서랍이 쓰는 팔레트의 자리
 *  번호입니다(0 산호, 1 하늘, 2 초록, 3 노랑, 4 분홍, 5 회색).
 *
 *  자리 번호를 그대로 쓰지 않고 따로 적는 이유는, 색이 그림과 어울려야
 *  하기 때문입니다. 세이렌은 바다를 건너는 이야기라 하늘색이 맞고, 셀레네는
 *  밤하늘에 별가루가 흩어지는 장면이라 노랑이 맞으며, 흥부와 놀부는 먹빛
 *  그림이라 분홍 위에서 가장 또렷합니다. `FACES` 가 색지가 아닌 자리에서는
 *  이 값을 쓰지 않습니다. */
const TINTS = [1, 1, 3, 5, 4];

/** 줄 한가운데에 세울 작품.
 *
 *  볼륨이 제 표지로 고른 작품입니다. 그 볼륨을 가장 잘 말해 주는 한 편이라
 *  서랍 표지에 걸리는 것이고, 그렇다면 줄에서도 가운데여야 합니다. 가운데는
 *  겹쳐진 카드 가운데 유일하게 온전히 보이는 자리이기 때문입니다. */
const middle = Math.floor((works.length - 1) / 2);
const featured = works.findIndex(
	(work) => work.volume.status === 'published' && work.volume.cover === work.chapter.id,
);

/** 색은 자리가 아니라 작품을 따라갑니다. 가운데로 옮겼다고 카드 색이 바뀌면
 *  같은 작품이 어제와 다른 물건으로 보입니다. 그래서 바탕은 옮기기 전의
 *  번호에서 뽑아 들고 다닙니다. */
const dressed = works.map((work, i) => ({
	...work,
	face: FACES[i % FACES.length],
	tint: swatchAt(TINTS[i % TINTS.length]).bg,
	/* 색지 카드의 바탕. 유리처럼 뒤가 비쳐야 하므로 74% 로 묽힙니다. 묽히는
	   일은 빌드할 때 해 둡니다 — 자세한 이유는 `fade` 에 적어 두었습니다. */
	tintFill: fade(swatchAt(TINTS[i % TINTS.length]).bg, 0.74),
}));

if (featured > -1 && featured !== middle) {
	dressed.splice(middle, 0, ...dressed.splice(featured, 1));
}

/** 부채. 손에 쥔 카드가 펼쳐진 모양입니다.
 *
 *  한 방향으로만 기울여 늘어놓으면 미끄러진 더미가 됩니다. 손에 쥔 카드는
 *  그렇게 서지 않습니다 — 가운데 것이 똑바로 서고, 좌우로 갈수록 바깥을
 *  향해 벌어지며, 벌어진 만큼 아래로 내려앉습니다. 그 내려앉는 자리가
 *  원호입니다.
 *
 *  각도는 가운데에서 몇 칸 떨어졌는지에 비례합니다. 내려앉는 깊이는 그
 *  각도의 코사인에서 나옵니다 — 반지름 `ARC_R` 인 원 위에 놓았을 때 그
 *  카드가 꼭대기에서 얼마나 내려오는지입니다. 손으로 적은 값이 아니라
 *  원에서 나온 값이라, 작품이 몇 편이 되든 같은 호를 그립니다. */
const FAN_STEP = 9;
/** 카드가 512px 일 때의 반지름. 실제로 쓰는 값은 카드 폭에 비례해
 *  스크립트가 다시 셉니다. */
const ARC_R = 1400;

const dealt = dressed.map((work) => ({
	...work,
	/** 이야기. 빈 줄로 나뉜 문단을 그대로 살립니다. */
	story: (work.chapter.description ?? '')
		.split(/\n\s*\n/)
		.map((part) => part.trim())
		.filter(Boolean),
}));

/** 한 벌을 두 번 깝니다.
 *
 *  부채는 끝없이 돌아갑니다. 한 벌만 깔면 마지막 카드 다음에 빈자리가
 *  오는데, 그 자리를 메우려고 첫 카드를 순간이동시키면 그 장면이 보입니다.
 *  두 벌을 깔아 두면 이음매가 화면에서 한참 벗어난 자리에 생기므로, 돌아도
 *  끊기는 곳이 없습니다.
 *
 *  자리와 각도는 여기서 적지 않습니다 — 돌아가는 동안 매 순간 달라지므로
 *  스크립트가 잡습니다. 여기서 정하는 것은 몇 장을 깔지와, 처음에 어느
 *  카드가 한가운데에 설지뿐입니다. */
const deck = [...dealt, ...dealt];
const home = middle;
---

<div class="rail" data-rail data-home={home} style={`--rail-count: ${deck.length};`}>
	{/* 카드가 돌아설 때 뒤에 깔리는 판. 페이지를 끄는 것이 아니라 읽는 것
	    하나만 남기는 일입니다. 누르면 닫힙니다. */}
	<div class="scrim" data-scrim hidden></div>

	{
		deck.map(({ chapter, volume, href, face, tint, tintFill, story }, index) => (
			/* 자리와 물건을 나눕니다. 자리(`.slot`)는 돌지도 기울지도 않으므로,
			   카드를 한가운데로 옮길 거리를 잴 때 쓸 수 있는 유일한 기준입니다.
			   기운 카드에서 직접 재면 기운 만큼 비뚤어진 값이 나옵니다. */
			<div class="slot" data-slot data-index={index}>
				<div
					class="card"
					data-card
					data-face={face}
					style={face === 'tint' ? `--face-bg: ${tint}; --face-fill: ${tintFill};` : undefined}
				>
					<button class="card__front" type="button" data-open-card aria-expanded="false">
						<span class="card__shot">
							<img src={chapter.thumbSrc} alt="" loading="lazy" draggable="false" />

							{/* 손이 올라가면 도는 짧은 영상. 그림 위에 한 겹 얹어 두고
							    투명도로만 바꿉니다 — 그림을 치우고 영상을 넣으면 바뀌는
							    순간 카드가 한 번 비칩니다.

							    `preload="none"` 이 중요합니다. 영상은 그림보다 훨씬
							    무거운데, 손이 한 번도 닿지 않을 카드까지 미리 받아 두면
							    첫 방문이 그만큼 느려집니다. 손이 올라간 뒤에 받습니다. */}
							{chapter.previewSrc && (
								<video
									class="card__clip"
									data-clip
									src={chapter.previewSrc}
									muted
									loop
									playsinline
									preload="none"
									aria-hidden="true"
								/>
							)}
						</span>
						<span class="card__name">{chapter.title}</span>
						<span class="visually-hidden">이야기 보기</span>
					</button>

					<div class="card__back" data-back tabindex="-1" inert>
						<button class="card__close" type="button" data-close-card>
							<span class="visually-hidden">닫기</span>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path
									d="M7 7l10 10M17 7 7 17"
									fill="none"
									stroke="currentColor"
									stroke-width="1.6"
									stroke-linecap="round"
								/>
							</svg>
						</button>

						<div class="card__story">
							<p class="card__vol">{formatVolLabel(volume.number)}</p>
							<h3 class="card__heading">{chapter.title}</h3>
							{story.map((part) => (
								<p class="card__text">{part}</p>
							))}
							{chapter.creator && <p class="card__by">{chapter.creator}</p>}
						</div>

						{href && (
							<a class="card__cta" href={href}>바로가기</a>
						)}
					</div>
				</div>
			</div>
		))
	}
</div>

<style>
	/* 줄은 화면 폭보다 넓습니다. 양 끝 카드가 화면 밖으로 잘리는 것이 이
	   구성의 전부이므로 가로로는 잘라 두고, 세로는 열어 둡니다 — 가리킨
	   카드가 위로 떠오르는데 그 자리가 아직 화면이기 때문입니다. `clip` 은
	   `hidden` 과 달리 스크롤 상자를 만들지 않으므로 페이지에 가로 스크롤이
	   생기지 않습니다. */
	/* 열린 카드가 커지는 배율. 넓은 화면에서는 10% 입니다 — 한가운데로 옮겨
	   오는 것만으로 이미 눈이 따라오므로, 크기는 거들기만 하면 됩니다.
	   좁은 화면에서는 이야기가 들어갈 자리가 나오지 않습니다. 카드 자체가
	   작아서 10% 를 더해도 뒷면에 한 줄밖에 실리지 않았습니다. 화면 폭이
	   허락하는 만큼 더 키웁니다. */
	.rail {
		--open-scale: 1.1;
		/* 자리들이 모두 절대 위치라 줄이 제 높이를 스스로 갖지 못합니다.
		   카드 한 장의 높이에 부채가 내려앉는 깊이를 더한 값을 스크립트가
		   재서 넣습니다. 식으로 어림해 두었더니 제목 줄의 실제 높이만큼
		   어긋나 카드 발치가 잘렸습니다 — 재는 편이 정확합니다. */
		height: var(--rail-h, 26rem);
		position: relative;
		overflow-x: clip;
		overflow-y: visible;
		/* 손으로 끌어 돌립니다. 끄는 동안 글자가 잡혀 끌려 나오지 않도록
		   선택을 막고, 브라우저가 가로 스크롤로 채가지 않도록 세로만
		   넘깁니다. */
		touch-action: pan-y;
		user-select: none;
		-webkit-user-select: none;
	}

	/* 카드가 놓이는 자리.
	 *
	 *  전부 줄 한가운데에 겹쳐 두고, 부채에서의 제자리까지는 옮겨 놓기로
	 *  갑니다. 자리를 CSS 여백으로 잡던 것을 걷어 낸 이유는 부채가 돌기
	 *  때문입니다 — 돌아가는 동안 매 순간 달라지는 값을 여백으로는 적을
	 *  수 없습니다.
	 *
	 *  옮겨 놓기만 맡고 돌지는 않습니다. 기우는 것은 그 안의 카드이고,
	 *  그래야 이 상자가 똑바로 서 있어서 카드를 화면 한가운데로 보낼 거리를
	 *  잴 기준이 됩니다. */
	.slot {
		position: absolute;
		top: 0;
		left: 50%;
		width: var(--rail-w);
		margin-left: calc(var(--rail-w) / -2);
		translate: var(--x, 0px) var(--y, 0px);
		/* 뒤집힘이 깊이를 갖게 하는 것은 이 하나입니다. 없으면 카드가 도는
		   것이 아니라 가로로 납작해졌다 펴집니다. */
		perspective: 1600px;
		transition-property: translate, opacity;
		transition-duration: 380ms;
		transition-timing-function: var(--ease-out);
	}

	/* 처음 펼쳐질 때만 느리게 갑니다.
	 *
	 *  자리를 옮기는 전환은 본디 끌어 놓았을 때 붙는 속도(380ms)에 맞춰져
	 *  있습니다. 그것은 손이 방금 한 일에 대한 응답이라 빨라야 하지만, 페이지가
	 *  처음 열리며 한 벌이 펼쳐지는 것은 응답이 아니라 한 번 보여 주는
	 *  장면입니다. 같은 속도를 쓰면 다섯 장이 순식간에 튀어 나가 펼쳐지는
	 *  과정이 보이지 않습니다.
	 *
	 *  투명도는 반대로 짧게 둡니다. 한 벌이 먼저 놓이고 그 다음에 펼쳐져야
	 *  하는데, 나타나는 일과 펼쳐지는 일이 같은 시간을 쓰면 둘이 겹쳐서
	 *  「흐릿한 것이 흩어진다」로 보입니다. */
	.rail[data-dealing] .slot {
		transition-duration: 820ms, 260ms;
	}

	/* 끄는 동안에는 손끝을 그대로 따라갑니다. 전환이 걸려 있으면 손보다
	   한 박자 늦게 따라와 고무줄처럼 늘어집니다. */
	.rail[data-dragging] .slot,
	.rail[data-dragging] .card {
		transition-duration: 0s;
	}

	.card {
		position: relative;
		display: block;
		border-radius: var(--card-radius);
		rotate: var(--lean);
		/* 앞뒷면이 한 물건의 두 면으로 놓이려면 3차원이 살아 있어야 합니다. */
		transform-style: preserve-3d;
		transition-property: translate, rotate, scale, transform;
		transition-duration: 380ms;
		transition-timing-function: var(--ease-out);
	}

	/* ── 두 면 ────────────────────────────────────────────────────────── */

	.card__front,
	.card__back {
		display: flex;
		flex-direction: column;
		width: 100%;
		padding: var(--card-pad) var(--card-pad) var(--card-foot);
		/* 바깥 반경은 안쪽 반경에 여백을 더한 값입니다. 두 곡선의 중심이
		   맞아야 카드가 한 장의 물건으로 보입니다. */
		border-radius: var(--card-radius);
		/* 돌아선 면은 보이지 않습니다. 이것이 없으면 뒷면의 글씨가 앞면에
		   거울처럼 비칩니다. */
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
		backdrop-filter: var(--card-blur);
		-webkit-backdrop-filter: var(--card-blur);
		text-align: left;
		box-shadow:
			var(--glass-rim),
			var(--glass-sheen),
			0 30px 64px -28px rgb(0 0 0 / 0.75);
	}

	.card__front,
	.card__back button,
	.card__cta {
		-webkit-tap-highlight-color: transparent;
	}

	.card__front {
		position: relative;
		z-index: 1;
		align-items: center;
		gap: var(--card-gap);
		border: 0;
		font: inherit;
		cursor: pointer;
	}

	/* 뒷면은 앞면 위에 포개 두고 반 바퀴 돌려 둡니다. 돌아서기 전에는
	   등을 보이고 있으므로 눈에 띄지 않습니다. */
	.card__back {
		position: absolute;
		inset: 0;
		/* 열릴 때 초점이 여기로 옵니다. 읽을 곳을 가리키는 것이지 누를 곳을
