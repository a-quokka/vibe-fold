---
/** Home → volume, the first half of the transition.
 *
 *  Clicking a folder does not navigate straight away. The stack clears itself
 *  out of the way and the chosen folder takes the tagline's place in the middle
 *  of the screen, lying on its side. Only then does the page change — and the
 *  volume page opens with that same folder in that same spot, so the two halves
 *  read as one move rather than as a cut.
 *
 *  The folder that flies is a copy, not the folder itself. The stack sits in a
 *  clipped section under a shared `perspective`, and an element with perspective
 *  is a containing block for its fixed-position descendants: the real folder
 *  cannot leave that box. The copy is appended to the body, where the viewport
 *  is the only frame it answers to.
 */
---

<script>
	import { gsap } from 'gsap';

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

	/** One flight at a time. The label and the tab both sit above the cover's
	 *  link, so a single press can surface as more than one click on the way up. */
	let flying = false;

	/** 폴더가 가운데로 올 때 비켜 주어야 하는 것들.
	 *
	 *  아래로 내려가며 물러납니다. 서랍의 다른 폴더들이 이미 화면 밑으로
	 *  떨어지고 있으므로, 그 아래에 있던 것들도 같은 방향으로 빠지는 것이
	 *  한 방향의 비움으로 읽힙니다. 슬로건만 위로 빠집니다 — 폴더보다 위에
	 *  있던 것이라 위로 가는 것이 제 방향입니다. */
	const CLEARED = ['.curation', '[data-archive]', '.home__foot'];

	/** 화면에 붙어 떠 있는 단추들. 자리가 페이지에 없으므로 같이 내려갈 수
	 *  없고, 옅어지는 것으로만 물러납니다. 내려가는 시늉을 하면 페이지와
	 *  따로 떨어져 움직이는 것으로 보입니다. */
	const FLOATING = ['.join-dock', '.gb-open'];

	/** What the volume page needs to pick the folder up where this page put it
	 *  down: the size it is holding when the screen changes. */
	const HANDOFF = 'vibe-fold:handoff';

	/** What the page keeps on either side of a folder, opened or turned. The
	 *  same 16px the stage tokens hold to. */
	const MARGIN = 16;

	/** A length written in CSS, measured rather than parsed — both halves of the
	 *  transition read their geometry from the same custom properties. */
	function cssLength(property: string): number {
		const probe = document.createElement('div');
		probe.style.cssText = `position:fixed;left:0;top:0;width:0;height:var(${property});visibility:hidden;pointer-events:none`;
		document.body.appendChild(probe);
		const { height } = probe.getBoundingClientRect();
		probe.remove();
		return height;
	}

	/** The states the stack writes on a folder while it is being pointed at.
	 *  The copy has to leave without any of them. */
	const HOVER_STATE = ['open', 'peek', 'shifted', 'peekShifted', 'revealed', 'pushed', 'front'];

	function fly(folder: HTMLElement, href: string) {
		const stack = folder.parentElement;
		if (!stack) return;

		const others = Array.from(stack.querySelectorAll<HTMLElement>('.folder')).filter(
			(other) => other !== folder,
		);
		const from = folder.getBoundingClientRect();

		/** How big it may be when it gets there.
		 *
		 *  It crosses at the size it is already standing at — a folder picked up
		 *  off a desk does not shrink on the way to the eye — right up until that
		 *  will not fit. Turned a quarter, the folder is as wide as it is now
		 *  tall, and on a phone that is the whole height of the drawer laid
		 *  across a screen a third as wide. So it gives back only what it has to,
		 *  and keeps the page's 16px on either hand. */
		const page = document.documentElement.clientWidth;
		/** The tab belongs to the folder's width, not to its own. Turned, it
		 *  stands off the trailing edge and its height is the room it takes
		 *  there, so it comes out of the space the folder has to fit into and
		 *  the pair is centred together — centred on the folder alone, the tab
		 *  hangs over the margin on the right. */
		const tab = cssLength('--tab-height');
		const room = page - MARGIN * 2 - tab;
		const shrink = Math.min(1, room / from.height);
		const size = { width: from.width * shrink, height: from.height * shrink };
		const centreX = page / 2 - tab / 2;

		/** Centred, but never into the navigation's band. Wherever it stops is
		 *  where the next page has to start, and the quarter turn happens on that
		 *  spot: turned, the folder is as tall as it is now wide, so the half it
		 *  has to keep clear of the band is the larger of the two. What that
		 *  pushes past the bottom of the screen goes past the bottom of the
		 *  screen — there is nothing down there to protect. */
		const clear = cssLength('--stage-clear');
		const turned = Math.max(size.width, size.height) / 2;
		const centreY = Math.max(window.innerHeight / 2, clear + turned);
		const to = {
			width: size.width,
			height: size.height,
			left: centreX - size.width / 2,
			top: centreY - size.height / 2,
		};

		/** What it is holding when the screen changes, and where on the screen it
		 *  is holding it. The next page puts a folder down on that exact spot, so
		 *  the change of page has nothing in it to see.
		 *
		 *  Stamped when the page is actually left, not now. The flight takes a
		 *  second and a half, and the reader on the other side treats an old
		 *  record as somebody who arrived some other way — written here, the
		 *  animation was spending most of the record's life before the next page
		 *  had even been asked for, and on a real connection the rest went to
		 *  fetching it. The record then read as stale and the volume page opened
		 *  the way it does for a bookmark. On localhost that never happened,
		 *  which is why the two looked like different transitions. */
		const handOver = () => {
			try {
				sessionStorage.setItem(
					HANDOFF,
					JSON.stringify({
						id: folder.dataset.flipId ?? '',
						width: to.width,
						height: to.height,
						centreX: to.left + to.width / 2,
						centreY: to.top + to.height / 2,
						at: Date.now(),
					}),
				);
			} catch {
				// Private browsing: the volume page simply opens at its own size.
			}
		};

		const proxy = folder.cloneNode(true) as HTMLElement;
		HOVER_STATE.forEach((key) => delete proxy.dataset[key]);
		proxy.dataset.flightProxy = 'true';
		proxy.style.cssText += `
			position: fixed;
			left: ${from.left}px;
			top: ${from.top}px;
			width: ${from.width}px;
			height: ${from.height}px;
			margin: 0;
			z-index: 40;
			transform: none;
			/* About its own middle. In the stack a folder is hinged at its foot —
			   that is what a cover opens about — and the clone inherits that
			   origin. Turned about the foot, the quarter turn swings the folder
			   down and to the right instead of pivoting where it stands. */
			transform-origin: 50% 50%;
			translate: none;
			transition: none;
			pointer-events: none;
		`;
		/** Parked, not shown. A clone on `document.body` sits above the whole
		 *  stack whatever its z-index — it is in another stacking context — so a
		 *  folder taken from the back of the drawer would jump in front of every
		 *  folder still standing ahead of it. The original stays where it is,
		 *  at its own depth, until those have left. */
		proxy.style.visibility = 'hidden';
		document.body.appendChild(proxy);

		// The stack's own transitions run at 1300ms. Left in place they would lag
		// a frame behind every value the timeline writes.
		others.forEach((other) => {
			other.style.transition = 'none';
		});

		/** 표지에 얹힌 것. 이름과 소개글(`.folder__copy`), 발치의 연도
		 *  (`.folder__when`), 표지에 붙은 그림(`.folder__shot`), 그리고 펼침
		 *  표시(`.folder__heading`)입니다. 색지 자체는 남습니다 — 날아가는
		 *  것이 폴더이므로 폴더는 보여야 합니다.
		 *
		 *  이 목록은 표지의 실제 이름과 맞아야 합니다. 예전에는 여기에
		 *  `.folder__summary` 와 `.folder__colophon` 이 적혀 있었는데, 그
		 *  이름을 가진 요소는 표지에 없습니다(볼륨 페이지의 이름입니다).
		 *  그래서 펼침 표시만 사라지고 이름과 소개글, 연도, 그림은 그대로
		 *  달린 채 돌아갔습니다. */
		const PRINTED = '.folder__copy, .folder__when, .folder__shot, .folder__heading';
		/** 다른 폴더들이 다 빠져나가는 시각. 마지막 폴더가 반 박자씩 늦게
		 *  출발하므로, 그 늦어진 만큼을 더해야 줄이 완전히 비는 때가 됩니다.
		 *  집어 올리는 것도 도는 것도 이 시각부터입니다. */
		const PICKUP = 0.72 + 0.06 * Math.max(0, others.length - 1);

		const timeline = gsap.timeline({
			onComplete: () => {
				handOver();
				window.location.href = href;
			},
		});

		// 1. Everything else leaves. The folders drop out of the bottom of the
		//    stack — the section clips them — and the tagline fades off the top.
		//    The chosen folder does not move yet: it is still the one in the
		//    drawer, and the ones ahead of it travel over it as they go.
		timeline
			.to(
				others,
				{
					y: () => window.innerHeight,
					duration: 0.72,
					ease: 'power2.in',
					stagger: 0.06,
				},
				0,
			)
			.to('.slogan', { opacity: 0, y: -32, duration: 0.5, ease: 'power2.in' }, 0)
			/* 폴더 아래에 있던 것들이 아래로 빠집니다. 위에서부터 한 박자씩
			   늦게 떠나므로 한 덩어리가 사라지는 것이 아니라 훑고 내려가는
			   것으로 보입니다. */
			.to(
				CLEARED.map((selector) => document.querySelector(selector)).filter(Boolean),
				{ y: 64, opacity: 0, duration: 0.5, ease: 'power2.in', stagger: 0.06 },
				0,
			)
			.to(
				FLOATING.map((selector) => document.querySelector(selector)).filter(Boolean),
				{ opacity: 0, duration: 0.28, ease: 'power2.in' },
				0,
			)
			/* 표지에 적힌 것이 먼저 물러납니다.
			 *
			 * 돌기 시작한 뒤에 글이 사라지면, 사라지는 일과 도는 일이 겹쳐
			 * 무엇이 먼저인지 읽히지 않고 글이 도중에 끊긴 것처럼 보입니다.
			 * 다른 폴더들이 빠져나가는 동안 이 폴더는 가만히 서 있으므로, 그
			 * 사이에 표지를 비워 둡니다 — 집어 올릴 때는 이미 빈 표지이고,
			 * 도는 것은 빈 표지가 도는 일이 됩니다. 0.52초에 끝나므로 집어
			 * 올리는 0.78초까지 4분의 1초가 남습니다.
			 *
			 * 서랍에 선 폴더와 날아갈 사본을 함께 지웁니다. 사본은 누른
			 * 순간에 떠 낸 것이라 그때의 모습을 그대로 들고 있어서, 한쪽만
			 * 지우면 집어 올리는 순간 글이 되살아납니다. 사본은 아직 숨어
			 * 있으므로 여기서 지우는 것은 눈에 보이지 않습니다. */
			.to(
				[...folder.querySelectorAll(PRINTED), ...proxy.querySelectorAll(PRINTED)],
				{ opacity: 0, duration: 0.56, ease: 'power2.out' },
				0.06,
			)
			// The stack is clear. From here the folder is a thing being carried
			// rather than a thing standing in a drawer, so the clone takes over.
			.call(
				() => {
					proxy.style.visibility = '';
					folder.style.visibility = 'hidden';
				},
				[],
				PICKUP,
			)
			/* 2. 먼저 제 갈 자리로 올라옵니다. 아직 돌지 않습니다.
			 *
			 * 순서가 중요합니다. 예전에는 서랍이 있던 아래쪽에서 돌고 나서
			 * 자리를 옮겼는데, 그러면 도는 동안 눈이 폴더를 화면 아래에서
			 * 따라가다가 페이지가 바뀌는 순간 위쪽에 놓인 폴더를 다시 찾게
			 * 됩니다 — 같은 자리에 놓여 있어도 뛰는 것으로 보입니다. 올라와
			 * 자리를 잡은 뒤에 도니, 도는 동안에도 다음 페이지에서와 같은
			 * 자리에 있습니다.
			 *
			 * 크기도 여기서 잡습니다. 다음 페이지가 이어받는 것은 이 자리와
			 * 이 크기이고, 둘 다 도는 것과 무관하게 정해집니다. */
			.to(
				proxy,
				{
					left: to.left,
					top: to.top,
					width: to.width,
					height: to.height,
					duration: 0.52,
					ease: 'power2.inOut',
				},
				PICKUP,
			)
			/* 3. 그 자리에서 네 분의 일 돕니다.
			 *
			 * 가운데를 축으로 도므로 자리는 한 픽셀도 움직이지 않습니다. 탭이
			 * 윗변을 떠나 뒤쪽 변에 가서 서는 것이 이 회전이고, 서랍에 꽂아
			 * 두는 자세에서 손에 들고 읽는 자세로 바뀝니다. 페이지는 이 동작이
			 * 끝나고 바뀝니다. */
			.to(
				proxy,
				{
					rotation: 90,
					duration: 0.44,
					ease: 'power3.inOut',
				},
				PICKUP + 0.52,
			);
	}

	/** Coming back with the back button can hand the page back exactly as it was
	 *  left — mid-flight, with the stack cleared away and a copy of a folder
	 *  parked in the middle of the screen. Put it back. */
	window.addEventListener('pageshow', (event) => {
		if (!event.persisted) return;

		flying = false;
		gsap.killTweensOf('*');
		document.querySelectorAll('[data-flight-proxy]').forEach((proxy) => proxy.remove());
		document.querySelectorAll<HTMLElement>('.folder-stack .folder').forEach((folder) => {
			folder.style.visibility = '';
			folder.style.transition = '';
			gsap.set(folder, { clearProps: 'transform' });
		});
		gsap.set(['.slogan', ...CLEARED, ...FLOATING], { clearProps: 'opacity,transform' });
	});

	/** The whole folder is the trigger — the cover, the copy printed on it, the
	 *  label, the tab. The link that covers the folder is underneath the cover in
	 *  the stacking order and never sees a press of its own, so the folder is
	 *  read off the event and the link only asked where it goes.
	 */
	document.addEventListener('click', (event) => {
		if (flying) return;

		const target = event.target as HTMLElement | null;
		if (!target?.closest) return;

		// On touch the tab is how a folder is opened, not how it is left.
		if (!finePointer.matches && target.closest('.tab')) return;

		const folder = target.closest<HTMLElement>('.folder');
		if (!folder || folder.dataset.flightProxy === 'true') return;

		const link = folder.querySelector<HTMLAnchorElement>('.folder__page');
		if (!link) return;

		// A modified click is a request for a new tab, not for this.
		const mouse = event as MouseEvent;
		if (mouse.metaKey || mouse.ctrlKey || mouse.shiftKey || mouse.altKey || mouse.button !== 0) {
			return;
		}

		event.preventDefault();

		if (reduced.matches) {
			window.location.href = link.href;
			return;
		}

		flying = true;
		fly(folder, link.href);
	});
</script>
