---
/** Stickers.
 *
 *  The shapes the system puts things in — a banner, a message, a widget, an
 *  event, a Finder window — left lying on the page for the fun of it. They can
 *  be pushed around and nothing else: no links, no controls, nothing to press.
 *
 *  Drawn rather than placed as images. At this size a screenshot goes soft the
 *  moment it is scaled, and drawn ones share the site's own glass and take
 *  Korean copy about what is actually filed here.
 */
import BrandMark from './BrandMark.astro';

interface Props {
	/** What the stickers talk about. Copy is English throughout: these are the
	 *  system's own shapes, and the system speaks English. */
	vol: string;
	/** The volume's name in Latin letters — `Sokdam`, not `속담`. */
	name: string;
	/** How many works are filed in it. */
	count: number;
}

const { vol, name, count } = Astro.props;
const files = Array.from({ length: Math.min(count, 3) }, (_, index) => `Ch.${index + 1}`);
---

<div class="stickers" data-stickers aria-hidden="true">
	{/* Notification banner. */}
	<div class="sticker banner" data-sticker>
		<span class="banner__icon"><BrandMark /></span>
		<span class="banner__text">
			<span class="banner__from">Vibe Fold <span class="banner__dot">•</span> now</span>
			<span class="banner__line">{`${vol} ${name} is open`}</span>
		</span>
	</div>

	{/* Message. */}
	<div class="sticker message-sticker" data-sticker>
		<span class="message-sticker__bubble">Have you seen Ch.1 yet?</span>
		<span class="message-sticker__time">Today, 9:41 PM</span>
	</div>

	{/* Widget. */}
	<div class="sticker widget" data-sticker>
		<span class="widget__mark"></span>
		<span class="widget__title">{`This week: ${name}`}</span>
		<span class="widget__line">{`${count} works in one folder`}</span>
	</div>

	{/* Calendar event. */}
	<div class="sticker event" data-sticker>
		<span class="event__date">
			<span class="event__month">OCT</span>
			<span class="event__day">12</span>
		</span>
		<span class="event__text">
			<span class="event__name">{`${name} Archive`}</span>
			<span class="event__where">Online</span>
		</span>
	</div>

	{/* Finder window. */}
	<div class="sticker finder" data-sticker>
		<span class="finder__bar">
			<span class="finder__lights">
				<span class="finder__light finder__light--close"></span>
				<span class="finder__light finder__light--min"></span>
				<span class="finder__light finder__light--zoom"></span>
			</span>
			<span class="finder__name">{name}</span>
		</span>
		<span class="finder__body">
			<span class="finder__side">
				<span class="finder__group">Favorites</span>
				<span class="finder__row">Archive</span>
				<span class="finder__row">Works</span>
				<span class="finder__group">Tags</span>
				<span class="finder__row finder__row--tag">Live</span>
			</span>
			<span class="finder__files">
				{files.map((file) => (
					<span class="finder__file">
						<span class="finder__folder"></span>
						<span class="finder__label">{file}</span>
					</span>
				))}
			</span>
		</span>
	</div>
</div>

<style>
	.stickers {
		position: absolute;
		inset: 0 auto auto 0;
		/* Over the work windows and directly under the navigation. They are the
		   loose things on the desk; the windows are what is filed on it. */
		z-index: 96;
	}

	/* Dropped, not faded in: a short overshoot on the way to rest. Opacity is
	   quicker than the movement so the thing is solid before it settles. */
	.sticker {
		position: absolute;
		/* Several of these are drawn at a fixed width — a notification banner and
		   a calendar chip are the sizes they are. On a phone those are wider than
		   the screen, and one of them hanging off the right edge gives the whole
		   page a sideways scroll. */
		max-width: calc(100vw - 2rem);
		box-sizing: border-box;
		display: flex;
		user-select: none;
		cursor: grab;
		/* Placed by script; until then they are nowhere and invisible. */
		opacity: 0;
		translate: 0 14px;
		scale: 0.92;
		transition-property: opacity, translate, scale;
		transition-duration: 200ms, 420ms, 420ms;
		transition-timing-function: var(--ease-out), var(--ease-back), var(--ease-back);
	}

	.sticker[data-shown='true'] {
		opacity: 1;
		translate: 0 0;
		scale: 1;
	}

	/* Leaving is softer than arriving, and takes no bounce with it. */
	.sticker:not([data-shown='true']) {
		transition-duration: 200ms;
		transition-timing-function: var(--ease-out);
		translate: 0 8px;
		scale: 1;
	}

	.sticker[data-dragging='true'] {
		cursor: grabbing;
		scale: 1.02;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
	}

	/* --- Notification banner ------------------------------------------------ */
	/* The banner sets the scale for every row-shaped sticker: they are rows from
	   the same system, and at different sizes they read as unrelated things. */
	.banner {
		align-items: center;
		gap: 0.625rem;
		width: 19rem;
		padding: 0.75rem;
		border-radius: 1.125rem;
		background: rgb(246 246 248 / 0.86);
		color: #1c1c1e;
		box-shadow:
			inset 0 0.5px 0 rgb(255 255 255 / 0.7),
			0 0 0 0.5px rgb(0 0 0 / 0.16),
			0 18px 44px -16px rgb(0 0 0 / 0.5);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
	}

	/* The app icon, with our own mark on it. */
	.banner__icon {
		flex: none;
		display: grid;
		place-items: center;
		width: 2.5rem;
		height: 2.5rem;
		border-radius: 0.625rem;
		background: linear-gradient(160deg, #ff5f7a, #f8595e 60%, #d63f57);
		box-shadow: inset 0 0.5px 0 rgb(255 255 255 / 0.5);
		color: #ffffff;
	}

	/* The mark comes from its own component and carries none of this file's
	   scoping, so it is reached globally — and sized here rather than by the
	   header's token, which is set for a masthead. */
	.banner__icon :global(.brand-mark) {
		height: 1.0625rem;
	}

	.banner__text {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
		min-width: 0;
	}

	.banner__from {
		font-size: 0.8125rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.banner__dot {
		font-weight: 400;
		color: rgb(0 0 0 / 0.45);
	}

	.banner__line {
		font-size: 0.875rem;
		line-height: 1.25;
		color: rgb(0 0 0 / 0.82);
	}

	/* --- Message ------------------------------------------------------------ */
	.message-sticker {
		flex-direction: column;
		align-items: flex-end;
		gap: 0.25rem;
		width: 16rem;
	}

	.message-sticker__bubble {
		position: relative;
		padding: 0.625rem 0.875rem;
		border-radius: 1.125rem;
		background: #0a84ff;
		color: #ffffff;
		font-size: 0.9375rem;
		line-height: 1.3;
		box-shadow: 0 12px 30px -14px rgb(10 132 255 / 0.9);
	}

	/* The tail. A bubble without one is a rounded rectangle. Carved with a mask
	   rather than with a second shape in the page's colour: the sticker floats
	   over the folder, the paper and the dark ground by turns, and a cut-out
	   painted in any one of them would show against the other two. */
	.message-sticker__bubble::after {
		content: '';
		position: absolute;
		right: -0.375rem;
		bottom: 0;
		width: 1rem;
		height: 1rem;
		background: #0a84ff;
		border-bottom-left-radius: 1rem;
		mask: radial-gradient(circle 1rem at 100% 0, transparent 98%, #000 100%);
		-webkit-mask: radial-gradient(circle 1rem at 100% 0, transparent 98%, #000 100%);
	}

	.message-sticker__time {
		font-size: 0.6875rem;
		/* The sticker has no surface of its own under this line — it sits
		   straight on whatever the page is showing there, so the colour is fixed
		   rather than taken from the page's muted token. */
		color: rgb(255 255 255 / 0.6);
	}

	/* --- Widget ------------------------------------------------------------- */
	.widget {
		flex-direction: column;
		gap: 0.5rem;
		width: 9.5rem;
		padding: 0.875rem;
		border-radius: 1.375rem;
		background: linear-gradient(155deg, #2b2b31, #1c1c22 55%, #24242b);
		color: #ffffff;
		box-shadow:
			inset 0 0.5px 0 rgb(255 255 255 / 0.14),
			0 20px 48px -18px rgb(0 0 0 / 0.75);
	}

	.widget__mark {
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: radial-gradient(circle at 34% 32%, #f4f1ea 0 44%, #b9b4a8 45% 100%);
		box-shadow: inset -6px -2px 0 rgb(28 28 34 / 0.92);
	}

	.widget__title {
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.25;
	}

	.widget__line {
		font-size: 0.75rem;
		line-height: 1.3;
		color: rgb(255 255 255 / 0.6);
	}

	/* --- Calendar event ----------------------------------------------------- */
	/* The banner's measure, padding and type — the two sit on the same page and
	   have to look like the same kind of thing. */
	.event {
		align-items: center;
		gap: 0.625rem;
		width: 400px;
		padding: 0.75rem;
		/* The date block's corner plus the padding — concentric. A full pill at
		   this height reads as a button, not as an event. */
		border-radius: 1.25rem;
		background: #ffffff;
		color: #1c1c1e;
		box-shadow:
			0 0 0 0.5px rgb(0 0 0 / 0.14),
			0 14px 34px -16px rgb(0 0 0 / 0.5);
	}

	.event__date {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 2.5rem;
		border-radius: 0.5rem;
		overflow: hidden;
		background: #ffffff;
		box-shadow: 0 0 0 0.5px rgb(0 0 0 / 0.12);
	}

	.event__month {
		width: 100%;
		padding: 0.1875rem 0;
		background: #ff3b30;
		color: #ffffff;
		font-size: 0.5625rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-align: center;
		line-height: 1.2;
	}

	.event__day {
		padding: 0.0625rem 0 0.1875rem;
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.event__text {
		display: flex;
		flex-direction: column;
		gap: 0.0625rem;
	}

	.event__name {
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.25;
	}

	.event__where {
		font-size: 0.75rem;
		color: rgb(0 0 0 / 0.5);
		line-height: 1.2;
	}

	/* --- Finder window ------------------------------------------------------ */
	.finder {
		flex-direction: column;
		width: 24rem;
		border-radius: 0.75rem;
		overflow: hidden;
		background: rgb(246 246 248 / 0.88);
		color: #1c1c1e;
		box-shadow:
			inset 0 0.5px 0 rgb(255 255 255 / 0.7),
			0 0 0 0.5px rgb(0 0 0 / 0.22),
			0 26px 60px -20px rgb(0 0 0 / 0.55);
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
	}

	.finder__bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		height: 2.125rem;
		padding: 0 0.625rem;
	}

	.finder__lights {
		display: flex;
		gap: 0.5rem;
	}

	.finder__light {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.08);
	}

	.finder__light--close {
		background: #ff5f57;
	}

	.finder__light--min {
		background: #febc2e;
	}

	.finder__light--zoom {
		background: #28c840;
	}

	.finder__name {
		font-size: 0.8125rem;
		font-weight: 600;
		color: rgb(0 0 0 / 0.74);
	}

	.finder__body {
		display: grid;
		grid-template-columns: 8rem 1fr;
		min-height: 13rem;
		border-top: 0.5px solid rgb(0 0 0 / 0.08);
	}

	.finder__side {
		display: flex;
		flex-direction: column;
		gap: 0.1875rem;
		padding: 0.5rem 0.375rem;
		background: rgb(0 0 0 / 0.03);
		border-right: 0.5px solid rgb(0 0 0 / 0.08);
	}

	.finder__group {
		padding: 0.375rem 0.5rem 0.125rem;
		font-size: 0.6875rem;
		font-weight: 700;
		color: rgb(0 0 0 / 0.4);
	}

	.finder__row {
		padding: 0.25rem 0.5rem;
		border-radius: 0.375rem;
		font-size: 0.8125rem;
		color: rgb(0 0 0 / 0.72);
	}

	.finder__row--tag::before {
		content: '';
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.3125rem;
		border-radius: 50%;
		background: #ff3b30;
	}

	.finder__files {
		display: flex;
		flex-wrap: wrap;
		align-content: flex-start;
		gap: 0.5rem 0.25rem;
		padding: 0.75rem 0.5rem;
		background: #ffffff;
	}

	.finder__file {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.3125rem;
		width: 4.25rem;
	}

	/* The folder itself, in the system's blue rather than this page's stock. */
	.finder__folder {
		width: 3.125rem;
		height: 2.375rem;
		border-radius: 0.1875rem 0.3125rem 0.3125rem 0.3125rem;
		background: linear-gradient(180deg, #6fc3ff, #2f9bf4);
		box-shadow: inset 0 0.5px 0 rgb(255 255 255 / 0.6);
		position: relative;
	}

	.finder__folder::before {
		content: '';
		position: absolute;
		left: 0;
		bottom: 100%;
		width: 1.125rem;
		height: 0.3125rem;
		border-radius: 0.25rem 0.25rem 0 0;
		background: #59b4f7;
	}

	.finder__label {
		font-size: 0.6875rem;
		line-height: 1.2;
		text-align: center;
		color: rgb(0 0 0 / 0.75);
		overflow-wrap: anywhere;
	}

	/* Fewer and gentler, not none: the thing still arrives, it just does not
	   travel or spring to get here. */
	@media (prefers-reduced-motion: reduce) {
		.sticker,
		.sticker:not([data-shown='true']) {
			translate: 0 0;
			scale: 1;
			transition-property: opacity;
			transition-duration: 200ms;
		}
	}
</style>

<script>
	import { makeDraggable } from '../lib/draggable';

	const layer = document.querySelector<HTMLElement>('[data-stickers]');

	if (layer) {
		const stickers = Array.from(layer.querySelectorAll<HTMLElement>('[data-sticker]'));

		/** How far the page has to travel before another one turns up. A share of
		 *  the window rather than a pixel count, so the rhythm is the same on a
		 *  laptop and on a tall monitor: about one every time you settle after a
		 *  scroll, which is often enough to feel alive and rare enough not to
		 *  crowd what is being read. */
		const STRIDE = () => window.innerHeight * 0.7;

		/** How many are on screen at once. Two lets one arrive while the last is
		 *  still going. */
		const AT_ONCE = 2;

		const MARGIN = 24;

		const shown: HTMLElement[] = [];
		let stride = -1;

		const place = (sticker: HTMLElement) => {
			const width = sticker.offsetWidth;
			const height = sticker.offsetHeight;
			// The navigation's band, read from the same token the folder uses.
			// Nothing but the navigation goes in it.
			const probe = document.createElement('div');
			probe.style.cssText =
				'position:fixed;left:0;top:0;width:0;height:var(--stage-clear);visibility:hidden';
			document.body.appendChild(probe);
			const header = probe.getBoundingClientRect().height;
			probe.remove();

			const top =
				window.scrollY +
				header +
				MARGIN +
				Math.random() * Math.max(0, window.innerHeight - header - height - MARGIN * 2);
			// The page's own width, not the window's: `innerWidth` counts the
			// scrollbar, and a sticker placed against that lands past the right
			// edge and gives the page a sideways scroll of its own.
			const page = document.documentElement.clientWidth;
			const left = MARGIN + Math.random() * Math.max(0, page - width - MARGIN * 2);

			sticker.style.top = `${Math.round(top)}px`;
			sticker.style.left = `${Math.round(left)}px`;
			// A hand drops things at an angle; a grid does not.
			sticker.style.rotate = `${(Math.random() * 6 - 3).toFixed(2)}deg`;
		};

		const hide = (sticker: HTMLElement) => {
			delete sticker.dataset.shown;
		};

		const cycle = () => {
			const waiting = stickers.filter((sticker) => !shown.includes(sticker));
			if (waiting.length === 0) return;

			while (shown.length >= AT_ONCE) {
				const leaving = shown.shift();
				if (leaving) hide(leaving);
			}

			const next = waiting[Math.floor(Math.random() * waiting.length)];
			place(next);
			// A frame between placing and showing, so it fades in where it landed
			// rather than sliding from wherever it was last.
			requestAnimationFrame(() => {
				next.dataset.shown = 'true';
			});
			shown.push(next);
		};

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				ticking = false;
				const step = Math.floor(window.scrollY / STRIDE());
				if (step === stride) return;
				stride = step;
				cycle();
			});
		};

		// The first one lands with everything else, once the folder is open.
		window.addEventListener(
			'vibe-fold:opened',
			() => {
				stride = Math.floor(window.scrollY / STRIDE());
				cycle();
				window.addEventListener('scroll', onScroll, { passive: true });
			},
			{ once: true },
		);

		// Moved, and nothing more: there is nothing here to press.
		makeDraggable(stickers);
	}
</script>
