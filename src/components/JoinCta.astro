---
/** The way in.
 *
 *  The drawer says what has been made; this says who made it and that the
 *  door is open. It stands at the foot of the page on purpose — somebody who
 *  has just looked through the volumes is the person worth asking, and
 *  somebody who has not seen them yet has nothing to join.
 *
 *  Closed it is one word, because two links standing out on a page of covers
 *  are two more things competing with the work. Pointed at, the two ways in
 *  slide out from behind it, one to each side, and the word they came from
 *  stays where it was.
 */
---

<div class="join" data-join>
	<a
		class="join__way join__way--code"
		href="https://github.com/vibe-ai-coding-club"
		target="_blank"
		rel="noreferrer"
		tabindex="-1"
	>
		GitHub
	</a>

	<button class="join__open" type="button" data-join-open aria-expanded="false">참여하기</button>

	<a
		class="join__way join__way--talk"
		href="https://discord.gg/S2bHaWCUv"
		target="_blank"
		rel="noreferrer"
		tabindex="-1"
	>
		Discord
	</a>
</div>

<style>
	.join {
		position: relative;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}

	.join__open {
		position: relative;
		/* Above the two it hides, so they pass behind it on the way out rather
		   than across it. */
		z-index: 1;
		padding: 0.6rem 1.4rem;
		border: 1px solid oklch(1 0 0 / 0.22);
		border-radius: 999px;
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--text-nav);
		letter-spacing: 0.08em;
		text-indent: 0.08em;
		cursor: pointer;
		transition:
			border-color 200ms var(--ease-out),
			background-color 200ms var(--ease-out);
	}

	.join:hover .join__open,
	.join:focus-within .join__open {
		border-color: oklch(1 0 0 / 0.5);
	}

	/* Both start under the word and travel out from it. Absolute so the middle
	   never moves: whatever happens either side, 참여하기 stays on the centre
	   line of the page. */
	.join__way {
		position: absolute;
		top: 50%;
		left: 50%;
		translate: -50% -50%;
		padding: 0.6rem 1.1rem;
		border: 1px solid oklch(1 0 0 / 0.18);
		border-radius: 999px;
		background: var(--color-bg);
		color: var(--color-text);
		font-size: var(--text-nav);
		letter-spacing: 0.06em;
		text-indent: 0.06em;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition:
			translate 320ms var(--ease-back, cubic-bezier(0.34, 1.3, 0.64, 1)),
			opacity 220ms var(--ease-out),
			border-color 200ms var(--ease-out);
	}

	.join__way:hover {
		border-color: oklch(1 0 0 / 0.55);
	}

	.join:hover .join__way,
	.join:focus-within .join__way,
	.join[data-open='true'] .join__way {
		opacity: 1;
		pointer-events: auto;
	}

	.join:hover .join__way--code,
	.join:focus-within .join__way--code,
	.join[data-open='true'] .join__way--code {
		translate: calc(-50% - 6.25rem) -50%;
	}

	.join:hover .join__way--talk,
	.join:focus-within .join__way--talk,
	.join[data-open='true'] .join__way--talk {
		translate: calc(-50% + 6.25rem) -50%;
	}

	/* No pointer to hover with: both ways stand out from the start, because a
	   phone would otherwise show one word that appears to do nothing. */
	@media (hover: none), (pointer: coarse) {
		.join__way {
			opacity: 1;
			pointer-events: auto;
		}

		.join__way--code {
			translate: calc(-50% - 6.25rem) -50%;
		}

		.join__way--talk {
			translate: calc(-50% + 6.25rem) -50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.join__way {
			transition-duration: 140ms;
		}
	}
</style>

<script>
	const join = document.querySelector<HTMLElement>('[data-join]');
	const open = document.querySelector<HTMLButtonElement>('[data-join-open]');

	if (join && open) {
		const ways = Array.from(join.querySelectorAll<HTMLAnchorElement>('.join__way'));

		/** Hover is enough for a mouse and reaches nobody else. Pressing the word
		 *  opens it too, which is what a finger and a keyboard both do — and
		 *  while it is open the two ways can be tabbed to, which is why they are
		 *  out of the tab order until then. */
		const set = (on: boolean) => {
			if (on) join.dataset.open = 'true';
			else delete join.dataset.open;
			open.setAttribute('aria-expanded', String(on));
			ways.forEach((way) => {
				way.tabIndex = on ? 0 : -1;
			});
		};

		open.addEventListener('click', () => {
			set(join.dataset.open !== 'true');
		});

		// Reaching it by keyboard opens it; leaving closes it again.
		join.addEventListener('focusin', () => set(true));
		join.addEventListener('focusout', (event) => {
			if (join.contains(event.relatedTarget as Node)) return;
			set(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && join.dataset.open === 'true') set(false);
		});
	}
</script>
