---
/** How the home page arrives.
 *
 *  Straight off the reference's own timeline: the stack rises half its height
 *  into place while the folders themselves come up from below the fold at
 *  nearly twice their size, a hair apart from one another; the slogan is dealt
 *  out a line at a time, each line's letters rising from behind their own edge.
 *
 *  Everything it touches is hidden before the first paint and handed back at
 *  the end, so the page never shows its start state and the stack goes back to
 *  being driven by CSS the moment the entrance is over.
 */
---

<script is:inline>
	// Set on the element itself, before anything paints. A module script is
	// deferred, and by the time one runs the page has already shown the slogan
	// and the stack sitting in their finished positions.
	// Not when the page is being come back to. FolderReturn runs just before
	// this and claims the stack: a folder is flying in to be filed, and two
	// entrances cannot both have the drawer.
	if (!document.documentElement.dataset.returning) {
		document.documentElement.dataset.intro = 'pending';
	}
</script>

<style is:global>
	html[data-intro='pending'] .folder-stack,
	html[data-intro='pending'] .slogan__text {
		opacity: 0;
	}

	/* The drawer clips what is pushed past its foot, so the page does not grow a
	   screenful every time a label is pointed at. While the folders are arriving
	   that same clip cuts them off at the section's bottom edge, and a folder
	   travelling up from below reads as one whose foot is nailed down and whose
	   length is changing. The clip region is let out for the entrance only —
	   `overflow-clip-margin` moves where the cut falls without adding a pixel of
	   scrollable page. */
	html[data-intro='running'] .folders {
		overflow-clip-margin: 60vh;
	}

	/* The word rises from behind its own edge rather than from nothing.
	 *
	 * The box is drawn around the word and not around each letter, and that is
	 * a measurement decision rather than a stylistic one. A box per letter
	 * rounds every letter's advance to a whole pixel and cuts the kerning
	 * between it and its neighbour; across this line that came to 3.5px of
	 * extra width, which the slogan gave back in one visible jump the moment
	 * the plain text was restored. Per word the line measures the same to a
	 * hundredth of a pixel, because the kerning that matters all happens
	 * inside a word. */
	.slogan__word {
		display: inline-block;
		overflow: hidden;
		vertical-align: bottom;
		white-space: nowrap;
	}

	.slogan__word > span {
		display: inline-block;
		will-change: transform;
	}
</style>

<script>
	import { gsap } from 'gsap';

	const root = document.documentElement;
	const stack = document.querySelector<HTMLElement>('.folder-stack');
	const title = document.querySelector<HTMLElement>('.slogan__text');
	const folders = stack ? Array.from(stack.querySelectorAll<HTMLElement>('.folder')) : [];

	const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	/** Set by the split, called when the timeline is done. */
	let restore: (() => void) | null = null;

	/** Wrap every word in a clipped box of its own and hand back the words,
	 *  grouped into the lines they actually landed on. Measured rather than
	 *  declared: the slogan is balanced by the browser, so where it breaks
	 *  depends on the width it was given.
	 *
	 *  A line rises as one piece, so the split only has to be fine enough to
	 *  tell the lines apart — and the word is the smallest unit that can be
	 *  boxed without changing what the line measures. */
	const splitLines = (element: HTMLElement): HTMLElement[][] => {
		/* 글자만이 아니라 마크업 전체를 들고 있다가 돌려줍니다. 글자만 담아
		   두면 지은이가 못 박아 둔 줄바꿈(`<br>`)이 쪼개는 동안 사라지고,
		   돌려줄 때도 되살아나지 않습니다. */
		const source = element.innerHTML;
		const parts = Array.from(element.childNodes);
		element.textContent = '';
		// Put back when the entrance is over. Every word is its own inline-block
		// while the animation runs, and a selection drawn across them comes out
		// as a row of separate boxes — the browser highlights each box, not the
		// line.
		restore = () => {
			element.innerHTML = source;
		};

		const words: HTMLElement[] = [];
		parts.forEach((part) => {
			// 못 박아 둔 줄바꿈은 그대로 다시 세웁니다.
			if (part.nodeName === 'BR') {
				element.append(document.createElement('br'));
				return;
			}

			(part.textContent ?? '').split(/(\s+)/).forEach((token) => {
				if (token === '') return;
				if (/^\s+$/.test(token)) {
					element.append(token);
					return;
				}

				const mask = document.createElement('span');
				mask.className = 'slogan__word';
				const inner = document.createElement('span');
				inner.textContent = token;
				mask.append(inner);
				element.append(mask);
				words.push(inner);
			});
		});

		const lines = new Map<number, HTMLElement[]>();
		words.forEach((word) => {
			// Rounded: words on one line differ by a fraction of a pixel.
			const top = Math.round(word.getBoundingClientRect().top);
			const line = lines.get(top);
			if (line) line.push(word);
			else lines.set(top, [word]);
		});

		return Array.from(lines.entries())
			.sort((a, b) => a[0] - b[0])
			.map(([, line]) => line);
	};

	const play = () => {
		// Nothing is hidden any more; from here the timeline holds the positions,
		// and the drawer's clip is let out until they have all landed.
		root.dataset.intro = 'running';

		if (reduced) {
			delete root.dataset.intro;
			gsap.fromTo(
				[stack, title].filter(Boolean),
				{ opacity: 0 },
				{ opacity: 1, duration: 0.3, ease: 'power2.out' },
			);
			return;
		}

		const lines = title ? splitLines(title) : [];
		/** Put the page back the way it will live: the slogan one run of text
		 *  again, the drawer clipping at its own foot. Safe to call twice.
		 *
		 *  Also on a timer, because `onComplete` rides on the frame clock and a
		 *  tab that is scrolled away, backgrounded or throttled may not get
		 *  enough frames to reach the end. Left half-done the slogan stays a row
		 *  of separate boxes, and a selection drawn across it comes out ragged. */
		let done = false;
		const finish = () => {
			if (done) return;
			done = true;
			restore?.();
			delete root.dataset.intro;
			// The entrance turned the slogan on by writing an inline opacity, and
			// an inline value outranks every rule in the stylesheet. Left there it
			// pins the slogan visible for the rest of the page's life — which is
			// what stopped it standing down for the curation. Handed back.
			if (title) gsap.set(title, { clearProps: 'opacity' });
		};

		const timeline = gsap.timeline({ defaults: { ease: 'power4.out' }, onComplete: finish });
		window.setTimeout(finish, 3000);

		if (stack) gsap.set(stack, { opacity: 1 });

		/** The reference's own numbers are yPercent 200 and scale 1.75, and they
		 *  do not transfer: its stack pages are thin strips, eight of them, so a
		 *  folder at 1.75x is still a band crossing the screen. Ours are two
		 *  full-height folders, and the same figures throw a screen-sized block
		 *  of colour across the page and snatch it back.
		 *
		 *  What carries over is the shape of the move — up from under the fold,
		 *  one folder a beat behind the next — at a size this object can take.
		 *  The lift is a lift, not a zoom. */
		if (folders.length > 0) {
			timeline.fromTo(
				folders,
				{ yPercent: 28 },
				{
					yPercent: 0,
					duration: 0.85,
					stagger: 0.07,
					/** A folder arriving, not a folder being stretched.
					 *
					 *  The scale that used to ride along with this came out as a
					 *  change of length: a folder is hinged at its foot — that is
					 *  what a cover opens about — so its transform origin is the
					 *  bottom edge, and anything scaled about that edge grows and
					 *  shrinks upward with its foot nailed down. Moving is the whole
					 *  of it now, and the overshoot is what makes it land rather
					 *  than stop. */
					ease: 'back.out(1.3)',
					// Handed back to CSS: from here the tilt and the push are the
					// stack's own business, and an inline transform would outrank
					// them. `translate` is listed because the push rides on that
					// property and GSAP folds it into its own matrix on the way in.
					clearProps: 'transform,translate,scale,rotate',
				},
				0,
			);
		}

		if (title) {
			gsap.set(title, { opacity: 1 });
			lines.forEach((line, index) => {
				timeline.fromTo(
					line,
					{ yPercent: 100, opacity: 0 },
					{ yPercent: 0, opacity: 1, duration: 0.9, clearProps: 'transform,opacity' },
					0.4 + index * 0.2,
				);
			});
		}
	};

	// The slogan has to be measured to be split, and it cannot be measured until
	// its font is the one it will be set in. Unless the page is being come back
	// to, in which case FolderReturn has the entrance and this one stands down.
	if (root.dataset.returning) {
		// nothing: the way back brings the stack and the slogan in itself.
	} else if (document.fonts && document.fonts.status !== 'loaded') {
		document.fonts.ready.then(play);
	} else {
		play();
	}
</script>
