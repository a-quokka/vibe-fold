---
/** The volume's works, scattered over the page as windows.
 *
 *  A desktop window is the form a piece of work actually arrives in — title
 *  bar, three lights, the thing itself underneath. They land at random once the
 *  folder has finished opening, so the page reads as a desk with a few windows
 *  left open on it rather than as a list.
 */
interface Props {
	works: { href: string; label: string; title: string; thumb: string }[];
}

const { works } = Astro.props;
---

{
	works.length > 0 && (
		<div class="pops" data-pops>
			{works.map((work) => (
				<a class="pop" href={work.href} data-pop>
					<span class="pop__bar">
						<span class="pop__lights">
							<span class="pop__light pop__light--close"></span>
							<span class="pop__light pop__light--min"></span>
							<span class="pop__light pop__light--zoom"></span>
						</span>
						<span class="pop__name">{work.title}</span>
						{/* The trailing column is left empty on purpose: it balances the
						    lights so the name sits on the window's centre line. */}
						<span />
					</span>

					<span class="pop__canvas">
						<img class="pop__thumb" src={work.thumb} alt="" loading="lazy" draggable="false" />
						<span class="pop__label">{work.label}</span>
					</span>
				</a>
			))}
		</div>
	)
}

<style>
	.pops {
		position: absolute;
		inset: 0 auto auto 0;
		/* Directly under the navigation — see Stickers. */
		z-index: 95;
	}

	.pop {
		position: absolute;
		display: flex;
		flex-direction: column;
		/* The main thing on the page below the index, at the proportions a window
		   actually has: wide. A tall narrow card reads as a thumbnail with chrome
		   stuck on top. */
		width: max(420px, 26rem);
		/* The corner a window has now: wide, and the same all the way round. */
		border-radius: 0.75rem;
		/* Chrome the work sits in, not a panel bolted to it — light, faintly
		   translucent, and blurring what is behind the window the way every
		   surface on the system does. */
		background: rgb(246 246 248 / 0.82);
		color: #1c1c1e;
		overflow: hidden;
		backdrop-filter: blur(24px) saturate(180%);
		-webkit-backdrop-filter: blur(24px) saturate(180%);
		/* A hairline, a contact shadow, and the same halo as everything else
		   floating over the page, so the desk reads as one set of things. */
		box-shadow:
			inset 0 0.5px 0 rgb(255 255 255 / 0.7),
			0 0 0 0.5px rgb(0 0 0 / 0.22),
			0 1px 2px rgb(0 0 0 / 0.08),
			var(--glass-glow),
			0 30px 70px -20px rgb(0 0 0 / 0.55);
		/* Placed by script; until then they are nowhere and invisible. Landing
		   with a short overshoot — these arrive once, when the folder opens. */
		opacity: 0;
		translate: 0 14px;
		scale: 0.94;
		transition-property: opacity, translate, scale;
		transition-duration: 200ms, 420ms, 420ms;
		transition-timing-function: var(--ease-out), var(--ease-back), var(--ease-back);
	}

	.pop[data-shown='true'] {
		opacity: 1;
		translate: 0 0;
		scale: 1;
	}

	/* Hover is not an entrance: it retimes to something instant and unsprung. */
	@media (hover: hover) and (pointer: fine) {
		.pop[data-shown='true']:hover {
			scale: 1.03;
			transition-duration: 150ms;
			transition-timing-function: var(--ease-out);
		}
	}

	/* Picked up: no hover lift, a deeper shadow, and the cursor of something
	   being carried. */
	.pop[data-dragging='true'] {
		scale: 1;
		cursor: grabbing;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
		box-shadow:
			inset 0 0.5px 0 rgb(255 255 255 / 0.7),
			0 0 0 0.5px rgb(0 0 0 / 0.22),
			0 1px 2px rgb(0 0 0 / 0.08),
			var(--glass-glow),
			0 44px 100px -20px rgb(0 0 0 / 0.7);
	}

	/* The title bar: lights at the leading edge, the name in the middle, a
	   couple of tools at the trailing one. No strip of its own and no rule under
	   it — the bar is the top of the window, and a divider only belongs there
	   when something has scrolled under it. */
	.pop__bar {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 0.625rem;
		height: 2.375rem;
		padding: 0 0.75rem;
		/* A window is moved by its bar. The rest of it is still the work. */
		cursor: grab;
	}

	.pop__lights {
		display: flex;
		gap: 0.5rem;
	}

	/* Lit, always. These windows are all equally open on the desk; greying the
	   ones that are not being pointed at made the page look half-asleep. */
	.pop__light {
		width: 0.75rem;
		height: 0.75rem;
		border-radius: 50%;
		box-shadow: inset 0 0 0 0.5px rgb(0 0 0 / 0.08);
	}

	.pop__light--close {
		background: #ff5f57;
	}

	.pop__light--min {
		background: #febc2e;
	}

	.pop__light--zoom {
		background: #28c840;
	}

	/* The system's own focus ring, in the system's own blue. */
	.pop:focus-visible {
		outline: 2px solid #0a84ff;
		outline-offset: 2px;
	}

	.pop__name {
		font-size: 0.8125rem;
		font-weight: 600;
		line-height: 1;
		color: rgb(0 0 0 / 0.74);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* The window's contents: the work itself. */
	.pop__canvas {
		position: relative;
		display: block;
	}

	.pop__thumb {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		background: #f1f1f1;
		/* The one line in the window, where the chrome ends and the work starts. */
		border-top: 0.5px solid rgb(0 0 0 / 0.08);
	}

	.pop__label {
		position: absolute;
		left: 0.5rem;
		bottom: 0.5rem;
		padding: 0.1875rem 0.4375rem;
		border-radius: 0.375rem;
		background: rgb(28 28 30 / 0.55);
		color: #ffffff;
		font-size: 0.6875rem;
		font-weight: 600;
		line-height: 1;
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
	}

	@media (max-width: 720px) {
		.pop {
			width: min(86vw, 22rem);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pop {
			translate: 0 0;
			scale: 1;
			transition-property: opacity;
			transition-duration: 200ms;
		}
	}
</style>

<script>
	const layer = document.querySelector<HTMLElement>('[data-pops]');

	if (layer) {
		const cards = Array.from(layer.querySelectorAll<HTMLElement>('[data-pop]'));

		/** The works are listed under the sheet, in order, never across it.
		 *
		 *  They take the sheet's measure and follow one another down the folder:
		 *  a pair may lean on each other by up to ten pixels or stand up to
		 *  twenty apart, which is a pile that has been handled rather than a grid
		 *  or a heap. The folder is then grown to hold the last of them.
		 */
		const OVERLAP = 10;
		const GAP = 20;

		const scatter = () => {
			const folder = document.querySelector<HTMLElement>('[data-opening-folder]');
			const paper = document.querySelector<HTMLElement>('.opening__paper');
			if (!folder || !paper) return;

			const folderBox = folder.getBoundingClientRect();
			const paperBox = paper.getBoundingClientRect();
			const measure = Math.round(paperBox.width);

			// The sheet's measure: the windows are the works the page is about, and
			// a column that changes width under them reads as two layouts on one
			// page.
			cards.forEach((card) => {
				card.style.width = `${measure}px`;
			});

			const left = paperBox.left;
			let top = paperBox.bottom + window.scrollY + Math.random() * GAP;

			cards.forEach((card) => {
				// Read after the width is set: the thumbnail's ratio decides the rest.
				const height = card.offsetHeight;

				card.style.left = `${Math.round(left + (Math.random() * 16 - 8))}px`;
				card.style.top = `${Math.round(top)}px`;
				// A hand drops things at an angle; a grid does not. Small, because
				// these are as wide as the sheet and a real tilt would put a corner
				// outside the folder.
				card.style.rotate = `${(Math.random() * 2.4 - 1.2).toFixed(2)}deg`;

				top += height + (Math.random() * (GAP + OVERLAP) - OVERLAP);
			});

			// Whatever the pile came to, the folder is at least that tall.
			const needed = top - (folderBox.top + window.scrollY) + 40;
			folder.style.minHeight = `${Math.round(Math.max(folderBox.height, needed))}px`;
		};

		const reveal = () => {
			scatter();
			cards.forEach((card, index) => {
				window.setTimeout(() => {
					card.dataset.shown = 'true';
				}, index * 70);
			});
		};

		// They arrive when the folder has finished opening — there is nothing to
		// drop them on before that.
		window.addEventListener('vibe-fold:opened', reveal, { once: true });

		/** Windows are moved by hand. Anywhere on one will do — the bar is only
		 *  where the cursor says so — and the work still opens on a click,
		 *  because a drag has to travel before it counts as one. */
		let front = 1;

		cards.forEach((card) => {
			let originX = 0;
			let originY = 0;
			let startLeft = 0;
			let startTop = 0;
			let carrying = false;
			let moved = false;

			card.addEventListener('pointerdown', (event) => {
				if (event.button !== 0) return;

				originX = event.clientX;
				originY = event.clientY;
				startLeft = parseFloat(card.style.left) || 0;
				startTop = parseFloat(card.style.top) || 0;
				carrying = true;
				moved = false;

				// Whatever is picked up comes to the top of the pile and stays there.
				card.style.zIndex = String((front += 1));
				card.setPointerCapture(event.pointerId);
			});

			card.addEventListener('pointermove', (event) => {
				if (!carrying) return;

				const dx = event.clientX - originX;
				const dy = event.clientY - originY;
				// Under this it is a click that wandered, not a move.
				if (!moved && Math.abs(dx) < 5 && Math.abs(dy) < 5) return;

				moved = true;
				card.dataset.dragging = 'true';
				card.style.left = `${startLeft + dx}px`;
				card.style.top = `${startTop + dy}px`;
				event.preventDefault();
			});

			const drop = (event: PointerEvent) => {
				if (!carrying) return;
				carrying = false;
				delete card.dataset.dragging;
				card.releasePointerCapture?.(event.pointerId);
			};

			card.addEventListener('pointerup', drop);
			card.addEventListener('pointercancel', drop);

			// A window that was carried does not also open.
			card.addEventListener('click', (event) => {
				if (!moved) return;
				event.preventDefault();
				moved = false;
			});

			// The thumbnail is an image; without this the browser offers to drag it
			// out of the page instead.
			card.addEventListener('dragstart', (event) => event.preventDefault());
		});
	}
</script>
