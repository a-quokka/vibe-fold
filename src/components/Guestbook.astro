---
/** The guestbook.
 *
 *  A button sits in the corner of the volume the whole time you are reading it.
 *  Press it, write something, and what you wrote is dropped on the page as a
 *  message — the same blue bubble the stickers use, in a spot nobody chose.
 *  It can be pushed around like everything else lying on this desk.
 *
 *  Notes live in this browser only — `localStorage`, keyed by the page they
 *  were left on. There is no server behind this yet, so nobody else sees them.
 */
---

<div class="guestbook" data-guestbook>
	{/* What has been left here, lying about the page. */}
	<div class="guestbook__notes" data-guestbook-notes></div>

	{/* The way in. Parked in the corner for as long as the volume is open. */}
	<button class="gb-open pressable" type="button" data-guestbook-open hidden>메시지 보내기</button>

	<form class="composer glass" data-guestbook-composer hidden>
		<header class="composer__bar">
			<p class="composer__title">방명록</p>
			<button class="composer__close pressable" type="button" data-guestbook-cancel aria-label="닫기">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M6 6l12 12M18 6L6 18"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
					/>
				</svg>
			</button>
		</header>

		<textarea
			class="composer__field"
			data-guestbook-field
			rows="2"
			placeholder="남기고 싶은 말을 적어 주세요"
			aria-label="방명록"
		></textarea>

		<button class="composer__submit pressable" type="submit" data-guestbook-done>완료</button>

		<p class="composer__toast glass" data-guestbook-toast hidden>입력된 내용이 없어요</p>
	</form>
</div>

<style>
	.guestbook__notes {
		position: absolute;
		inset: 0 auto auto 0;
		/* With the stickers, over the work windows, under the navigation. */
		z-index: 96;
	}

	/* The way in. */
	.gb-open {
		position: fixed;
		right: clamp(1rem, 3vw, 2rem);
		bottom: clamp(1rem, 3vw, 2rem);
		z-index: 99;
		display: inline-flex;
		align-items: center;
		padding: 0.6875rem 1.125rem;
		border: 0;
		border-radius: 999px;
		background: rgb(28 28 30 / 0.62);
		color: #ffffff;
		font: inherit;
		font-size: var(--text-meta);
		font-weight: 600;
		line-height: 1;
		cursor: pointer;
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		box-shadow: var(--glass-shadow);
	}

	.gb-open[hidden] {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.gb-open:hover {
			background: rgb(28 28 30 / 0.78);
		}
	}

	.gb-open:focus-visible {
		outline: 2px solid var(--color-select);
		outline-offset: 3px;
	}

	/* What was left. The stickers' own message bubble, carrying somebody's
	   words instead of the site's. Scoped styles do not reach a node built in
	   script, so these are global and named for it. */
	:global(.gb-note) {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.25rem;
		user-select: none;
		cursor: grab;
		opacity: 0;
		translate: 0 14px;
		scale: 0.92;
		transition-property: opacity, translate, scale;
		transition-duration: 200ms, 420ms, 420ms;
		transition-timing-function: var(--ease-out), var(--ease-back), var(--ease-back);
	}

	:global(.gb-note[data-shown='true']) {
		opacity: 1;
		translate: 0 0;
		scale: 1;
	}

	:global(.gb-note[data-dragging='true']) {
		cursor: grabbing;
		scale: 1.02;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
	}

	:global(.gb-note__bubble) {
		position: relative;
		/* Somebody else's sentence has no length you can plan for. It runs to
		   here and then wraps.
		
		   `max-content` first: the layer these are dropped on is an absolutely
		   positioned box with no width of its own, so an auto-width child is
		   handed nothing to fill and wraps after every character. The second
		   term keeps it inside a phone, where 360px is wider than the screen. */
		width: max-content;
		max-width: min(360px, calc(100vw - 4rem));
		padding: 0.625rem 0.875rem;
		border-radius: 1.125rem;
		background: #0a84ff;
		color: #ffffff;
		font-size: 0.9375rem;
		line-height: 1.3;
		overflow-wrap: anywhere;
		box-shadow: 0 12px 30px -14px rgb(10 132 255 / 0.9);
	}

	:global(.gb-note__time) {
		font-size: 0.6875rem;
		color: rgb(255 255 255 / 0.6);
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.gb-note) {
			translate: 0 0;
			scale: 1;
			transition-property: opacity;
			transition-duration: 200ms;
		}
	}

	/* The composer. */
	.composer {
		position: fixed;
		bottom: clamp(1rem, 3vw, 2rem);
		left: 50%;
		/* Over the bar: it is a sheet the visitor opened, and it takes the focus
		   with it. */
		z-index: 120;
		display: flex;
		flex-direction: column;
		width: min(34rem, calc(100vw - 2rem));
		border-radius: 1.125rem;
		translate: -50% 0;
		animation: composer-in 260ms var(--ease-out) both;
	}

	.composer[hidden] {
		display: none;
	}

	@keyframes composer-in {
		from {
			opacity: 0;
			translate: -50% 12px;
		}
	}

	.composer__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.75rem 0 1rem;
	}

	.composer__title {
		margin: 0;
		color: #ffffff;
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.2;
	}

	/* Close is a mark, not a word — it is the one thing here that is not the
	   note being written. */
	.composer__close {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.12);
		color: #ffffff;
		cursor: pointer;
	}

	.composer__close svg {
		width: 1rem;
		height: 1rem;
	}

	.composer__close:hover {
		background: rgb(255 255 255 / 0.22);
	}

	/* No box at all — the note is written straight onto the glass, in white. The
	   field is the only thing in the sheet that takes typing, so there is nothing
	   for a rule to tell it apart from. */
	.composer__field {
		margin: 0.75rem 0.75rem 0;
		padding: 0.25rem 0.25rem 0;
		border: 0;
		background: transparent;
		color: #ffffff;
		font-family: inherit;
		font-size: var(--text-body);
		line-height: var(--lh-body);
		resize: none;
	}

	.composer__field:focus {
		outline: none;
	}

	.composer__field::placeholder {
		color: rgb(255 255 255 / 0.45);
	}

	/* The one action, across the foot. */
	.composer__submit {
		margin: 0.75rem;
		padding: 0.875rem;
		border: 0;
		border-radius: 0.75rem;
		background: #ffffff;
		color: #111111;
		font-family: inherit;
		font-size: var(--text-body);
		font-weight: 600;
		line-height: 1.2;
		cursor: pointer;
	}

	.composer__submit:hover {
		opacity: 0.88;
	}

	/* Says what went wrong where the thing that went wrong is, and goes on its
	   own — there is nothing to answer. */
	.composer__toast {
		position: absolute;
		bottom: 100%;
		left: 50%;
		margin: 0 0 0.625rem;
		padding: 0.5rem 0.875rem;
		border-radius: 999px;
		color: var(--color-text);
		font-size: var(--text-meta);
		line-height: 1.2;
		white-space: nowrap;
		translate: -50% 0;
		animation: message-in 260ms var(--ease-out) both;
	}

	.composer__toast[hidden] {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.gb-message),
		:global(.gb-message[data-leaving='true']),
		.composer {
			animation: none;
		}

		:global(.gb-pin) {
			transition: none;
		}
	}
</style>

<script>
	import { makeDraggable } from '../lib/draggable';

	type Note = { id: string; text: string; x: number; y: number; at: number };

	const layer = document.querySelector<HTMLElement>('[data-guestbook-notes]');
	const opener = document.querySelector<HTMLButtonElement>('[data-guestbook-open]');
	const composer = document.querySelector<HTMLFormElement>('[data-guestbook-composer]');
	const field = document.querySelector<HTMLTextAreaElement>('[data-guestbook-field]');
	const cancel = document.querySelector<HTMLButtonElement>('[data-guestbook-cancel]');
	const toast = document.querySelector<HTMLElement>('[data-guestbook-toast]');

	if (layer && opener && composer && field && cancel) {
		/** A volume is the thing worth signing. The front page is a drawer, and
		 *  the chapters are somebody else's work inside their own frame. */
		const PAGE = location.pathname.replace(/\/+$/, '') || '/';
		const onVolume = /^\/vol\/[^/]+$/.test(PAGE);
		const KEY = `vibe-fold:guestbook:v4:${PAGE}`;

		// Earlier rounds are retired with their keys: those notes were pinned to
		// a selection, and there are no pins any more.
		['', 'v2:', 'v3:'].forEach((v) => {
			try {
				localStorage.removeItem(`vibe-fold:guestbook:${v}${PAGE}`);
			} catch {
				// Nothing to clear if storage is not there to begin with.
			}
		});

		const read = (): Note[] => {
			try {
				const raw = localStorage.getItem(KEY);
				return raw ? (JSON.parse(raw) as Note[]) : [];
			} catch {
				return [];
			}
		};

		const write = (notes: Note[]) => {
			try {
				localStorage.setItem(KEY, JSON.stringify(notes));
			} catch {
				// Private browsing: the note lives as long as the page does.
			}
		};

		let notes = read();

		/** The band across the top belongs to the navigation, and a note dropped
		 *  against `innerWidth` lands past the right edge — that measure counts
		 *  the scrollbar. Both are the stickers' own rules. */
		const clearBand = () => {
			const probe = document.createElement('div');
			probe.style.cssText =
				'position:fixed;left:0;top:0;width:0;height:var(--stage-clear);visibility:hidden';
			document.body.appendChild(probe);
			const height = probe.getBoundingClientRect().height;
			probe.remove();
			return height;
		};

		const MARGIN = 16;

		const place = (note: HTMLElement) => {
			const page = document.documentElement.clientWidth;
			const band = clearBand();
			const width = note.offsetWidth;
			const height = note.offsetHeight;
			const left = MARGIN + Math.random() * Math.max(0, page - width - MARGIN * 2);
			const top =
				window.scrollY +
				band +
				MARGIN +
				Math.random() * Math.max(0, window.innerHeight - band - height - MARGIN * 2);
			return { left: Math.round(left), top: Math.round(top) };
		};

		const clock = (at: number) =>
			new Date(at).toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });

		const nodes: HTMLElement[] = [];

		const drop = (note: Note, settled: boolean) => {
			const el = document.createElement('div');
			el.className = 'gb-note';
			el.innerHTML = '<p class="gb-note__bubble"></p><span class="gb-note__time"></span>';
			el.querySelector('.gb-note__bubble')!.textContent = note.text;
			el.querySelector('.gb-note__time')!.textContent = clock(note.at);
			layer.appendChild(el);

			// Measured after it is in the document: where it lands depends on how
			// tall the sentence turned out.
			if (!settled) {
				const spot = place(el);
				note.x = spot.left;
				note.y = spot.top;
			}
			// A note written on a wide screen and read back on a narrow one would
			// otherwise sit off the right edge and take the page's margin with it.
			const page = document.documentElement.clientWidth;
			const x = Math.min(note.x, Math.max(MARGIN, page - el.offsetWidth - MARGIN));
			el.style.left = `${Math.max(MARGIN, x)}px`;
			el.style.top = `${note.y}px`;

			nodes.push(el);
			makeDraggable([el]);
			window.requestAnimationFrame(() => {
				el.dataset.shown = 'true';
			});
		};

		if (onVolume) {
			opener.hidden = false;
			notes.forEach((note) => drop(note, true));
		}

		let toastTimer = 0;

		/** The one thing that can go wrong here: nothing was written. */
		const complain = () => {
			if (!toast) return;
			toast.hidden = false;
			window.clearTimeout(toastTimer);
			toastTimer = window.setTimeout(() => {
				toast.hidden = true;
			}, 2000);
		};

		const close = () => {
			composer.hidden = true;
			field.value = '';
			if (toast) toast.hidden = true;
		};

		const open = () => {
			composer.hidden = false;
			field.focus();
		};

		opener.addEventListener('click', open);

		field.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') close();
			// Enter finishes the note; a new line takes a modifier, as a chat field
			// works.
			if (event.key === 'Enter' && !event.shiftKey) {
				event.preventDefault();
				composer.requestSubmit();
			}
		});

		cancel.addEventListener('click', close);

		composer.addEventListener('submit', (event) => {
			event.preventDefault();

			const text = field.value.trim();
			if (!text) {
				complain();
				field.focus();
				return;
			}

			const note: Note = {
				id: `${Date.now()}-${Math.round(Math.random() * 1e6)}`,
				text,
				x: 0,
				y: 0,
				at: Date.now(),
			};

			drop(note, false);
			notes = [...notes, note];
			write(notes);
			close();
		});
	}
</script>
