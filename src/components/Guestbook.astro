---
/** The guestbook.
 *
 *  A button sits in the corner of the volume the whole time you are reading it.
 *  Press it, write something, and what you wrote is dropped on the page as a
 *  message — the same blue bubble the stickers use, in a spot nobody chose.
 *  It can be pushed around like everything else lying on this desk.
 *
 *  Notes live in this browser only — `localStorage`, keyed by the page they
 *  were left on. There is no server behind this yet, so nobody else sees them.
 */
---

<div class="guestbook" data-guestbook>
	{/* What has been left here, lying about the page. */}
	<div class="guestbook__notes" data-guestbook-notes></div>

	{/* The way in. Parked in the corner for as long as the volume is open. */}
	<button class="gb-open pressable" type="button" data-guestbook-open hidden>방명록 남기기</button>

	<form class="composer glass" data-guestbook-composer hidden>
		<header class="composer__bar">
			<p class="composer__title">방명록</p>
			<button class="composer__close pressable" type="button" data-guestbook-cancel aria-label="닫기">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path
						d="M6 6l12 12M18 6L6 18"
						fill="none"
						stroke="currentColor"
						stroke-width="1.6"
						stroke-linecap="round"
					/>
				</svg>
			</button>
		</header>

		<textarea
			class="composer__field"
			maxlength="200"
			data-guestbook-field
			rows="2"
			placeholder="남기고 싶은 말을 적어 주세요"
			aria-label="방명록"
		></textarea>

		<button class="composer__submit pressable" type="submit" data-guestbook-done>완료</button>

		<p class="composer__toast glass" data-guestbook-toast hidden aria-live="polite"></p>
	</form>
</div>

<style>
	.guestbook__notes {
		position: absolute;
		inset: 0 auto auto 0;
		/* With the stickers, over the work windows, under the navigation. */
		z-index: 96;
	}

	/* The way in.
	 *
	 *  참여하기와 같은 재료로 만듭니다. 화면 발치에 떠서 눌리기를 기다리는
	 *  단추가 둘인데 하나는 어두운 유리, 하나는 밝은 유리이면 같은 자리에
	 *  놓인 두 단추가 서로 다른 물건으로 읽힙니다. */
	.gb-open {
		position: fixed;
		right: clamp(1rem, 3vw, 2rem);
		bottom: clamp(1rem, 3vw, 2rem);
		z-index: 99;
		display: inline-flex;
		align-items: center;
		padding: 0.875rem 1.75rem;
		border: 0;
		border-radius: 999px;
		/* `--color-text` 를 82% 로 묽힌 값입니다. 섞기(`color-mix`)로 적으면
		   iOS 16.2 아래에서는 그 줄이 버려지고 단추 바탕이 아예 칠해지지
		   않습니다 — 어두운 페이지 위에 글자만 남아 안 보입니다. */
		background: rgb(247 244 239 / 0.82);
		color: var(--color-bg);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 500;
		line-height: 1;
		letter-spacing: 0.06em;
		text-indent: 0.06em;
		cursor: pointer;
		backdrop-filter: blur(20px) saturate(180%);
		-webkit-backdrop-filter: blur(20px) saturate(180%);
		/* 참여하기와 같은 네 겹. 윗변에 걸린 빛, 가장자리를 도는 실테,
		   아랫변에 앉는 옅은 그늘, 페이지에 드리우는 그림자입니다. */
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 0.6),
			inset 0 0 0 0.5px rgb(255 255 255 / 0.35),
			inset 0 -1px 0 rgb(0 0 0 / 0.08),
			0 1px 2px rgb(0 0 0 / 0.3),
			0 18px 40px -12px rgb(0 0 0 / 0.72);
		-webkit-tap-highlight-color: transparent;
		transition-property: background, box-shadow, scale;
		transition-duration: 200ms;
		transition-timing-function: var(--ease-out);
	}

	.gb-open[hidden] {
		display: none;
	}

	@media (hover: hover) and (pointer: fine) {
		.gb-open:hover {
			background: rgb(247 244 239 / 0.94);
			box-shadow:
				inset 0 1px 0 rgb(255 255 255 / 0.7),
				inset 0 0 0 0.5px rgb(255 255 255 / 0.45),
				inset 0 -1px 0 rgb(0 0 0 / 0.08),
				0 1px 2px rgb(0 0 0 / 0.3),
				0 26px 56px -14px rgb(0 0 0 / 0.88);
			scale: 1.03;
		}
	}

	.gb-open:active {
		scale: 0.96;
		transition-duration: 140ms;
	}

	/* 발치 가운데에 섭니다.
	 *
	 *  오른쪽 구석은 엄지가 닿기에는 좋지만, 그 자리에서 발치의 서명과 링크
	 *  위에 겹쳐 앉았습니다. 이 단추는 볼륨 페이지에서만 서고(홈에서는 숨어
	 *  있습니다), 그 페이지의 발치에는 가운데를 다투는 것이 없습니다. */
	.gb-open {
		right: auto;
		left: 50%;
		translate: -50% 0;
	}

	.gb-open:focus-visible {
		outline: 2px solid var(--color-select);
		outline-offset: 3px;
	}

	/* What was left. The stickers' own message bubble, carrying somebody's
	   words instead of the site's. Scoped styles do not reach a node built in
	   script, so these are global and named for it. */
	:global(.gb-note) {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.25rem;
		user-select: none;
		cursor: grab;
		opacity: 0;
		translate: 0 14px;
		scale: 0.92;
		transition-property: opacity, translate, scale;
		transition-duration: 200ms, 420ms, 420ms;
		transition-timing-function: var(--ease-out), var(--ease-back), var(--ease-back);
	}

	:global(.gb-note[data-shown='true']) {
		opacity: 1;
		translate: 0 0;
		scale: 1;
	}

	:global(.gb-note[data-dragging='true']) {
		cursor: grabbing;
		scale: 1.02;
		transition-duration: 150ms;
		transition-timing-function: var(--ease-out);
	}

	:global(.gb-note__bubble) {
		position: relative;
		/* Somebody else's sentence has no length you can plan for. It runs to
		   here and then wraps.
		
		   `max-content` first: the layer these are dropped on is an absolutely
		   positioned box with no width of its own, so an auto-width child is
		   handed nothing to fill and wraps after every character. The second
		   term keeps it inside a phone, where 360px is wider than the screen. */
		width: max-content;
		max-width: min(360px, calc(100vw - 4rem));
		padding: 0.625rem 0.875rem;
		border-radius: 1.125rem;
		background: #0a84ff;
		color: #ffffff;
		font-size: 0.9375rem;
		line-height: 1.3;
		overflow-wrap: anywhere;
		box-shadow: 0 12px 30px -14px rgb(10 132 255 / 0.9);
	}

	:global(.gb-note__time) {
		font-size: 0.6875rem;
		color: rgb(255 255 255 / 0.6);
		/* A stamp of nothing but digits — they should stand in their columns. */
		font-variant-numeric: tabular-nums;
	}

	/* 좁은 화면의 말풍선은 한 단 작게. 남이 남긴 한 문장이 화면 폭의 절반을
	   차지하면, 그것은 곁에 놓인 쪽지가 아니라 읽어야 하는 본문이 됩니다.
	   글자와 여백, 둥글기를 같은 비율로 함께 줄여야 알약 모양이 유지
	   됩니다. */
	@media (max-width: 48rem) {
		:global(.gb-note__bubble) {
			max-width: min(260px, calc(100vw - 6rem));
			padding: 0.5rem 0.6875rem;
			border-radius: 0.875rem;
			font-size: 0.8125rem;
		}

		:global(.gb-note__time) {
			font-size: 0.625rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.gb-note) {
			translate: 0 0;
			scale: 1;
			transition-property: opacity;
			transition-duration: 200ms;
		}
	}

	/* The composer. */
	.composer {
		position: fixed;
		bottom: clamp(1rem, 3vw, 2rem);
		left: 50%;
		/* Over the bar: it is a sheet the visitor opened, and it takes the focus
		   with it. */
		z-index: 120;
		display: flex;
		flex-direction: column;
		width: min(34rem, calc(100vw - 2rem));
		border-radius: 1.125rem;
		translate: -50% 0;
		animation: composer-in 260ms var(--ease-out) both;
	}

	.composer[hidden] {
		display: none;
	}

	@keyframes composer-in {
		from {
			opacity: 0;
			translate: -50% 12px;
		}
	}

	.composer__bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.75rem 0 1rem;
	}

	.composer__title {
		margin: 0;
		color: #ffffff;
		font-size: var(--text-body);
		/* 한 단 낮춤. 이 글꼴은 600~700 을 Bold 한 벌로, 400~500 을 Medium
		   한 벌로 그리므로 600 에서 한 단 내리는 것은 500 입니다. */
		font-weight: 500;
		line-height: 1.2;
	}

	/* Close is a mark, not a word — it is the one thing here that is not the
	   note being written. */
	.composer__close {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 0;
		border-radius: 50%;
		background: rgb(255 255 255 / 0.12);
		color: #ffffff;
		cursor: pointer;
	}

	.composer__close svg {
		width: 1rem;
		height: 1rem;
	}

	.composer__close:hover {
		background: rgb(255 255 255 / 0.22);
	}

	/* No box at all — the note is written straight onto the glass, in white. The
	   field is the only thing in the sheet that takes typing, so there is nothing
	   for a rule to tell it apart from. */
	.composer__field {
		margin: 0.75rem 0.75rem 0;
		padding: 0.25rem 0.25rem 0;
		border: 0;
		background: transparent;
		color: #ffffff;
		font-family: inherit;
		font-size: var(--text-body);
		line-height: var(--lh-body);
		resize: none;
	}

	.composer__field:focus {
		outline: none;
	}

	.composer__field::placeholder {
		color: rgb(255 255 255 / 0.45);
	}

	/* The one action, across the foot. */
	.composer__submit {
		margin: 0.75rem;
		padding: 0.875rem;
		border: 0;
		border-radius: 0.75rem;
		background: #ffffff;
		color: #111111;
		font-family: inherit;
		font-size: var(--text-body);
		font-weight: 500;
		line-height: 1.2;
		cursor: pointer;
	}

	.composer__submit:hover {
		opacity: 0.88;
	}

	/* Says what went wrong where the thing that went wrong is, and goes on its
	   own — there is nothing to answer. */
	.composer__toast {
		position: absolute;
		bottom: 100%;
		left: 50%;
		margin: 0 0 0.625rem;
		padding: 0.5rem 0.875rem;
		border-radius: 999px;
		color: var(--color-text);
		font-size: var(--text-meta);
		line-height: 1.2;
		white-space: nowrap;
		translate: -50% 0;
		animation: message-in 260ms var(--ease-out) both;
	}

	.composer__toast[hidden] {
		display: none;
	}

	@media (prefers-reduced-motion: reduce) {
		:global(.gb-message),
		:global(.gb-message[data-leaving='true']),
		.composer {
			animation: none;
		}

		:global(.gb-pin) {
			transition: none;
		}
	}
</style>

<script>
	import { makeDraggable } from '../lib/draggable';
	import { fetchNotes, postNote, LIMIT, type Note } from '../lib/guestbook-store';

	/** A note on screen: what was written, and where this reader's page happens
	 *  to have put it. The spot is not stored anywhere — see the store. */
	type Placed = Note & { x: number; y: number };

	/** How many of the page's notes are shown at once, and how long a writer
	 *  waits between notes. The cap is so a well-signed volume stays a page and
	 *  not a wall; the pause is so a slip of the finger does not post twice. */
	const SHOWN = 14;
	const PAUSE = 20_000;

	const layer = document.querySelector<HTMLElement>('[data-guestbook-notes]');
	const opener = document.querySelector<HTMLButtonElement>('[data-guestbook-open]');
	const composer = document.querySelector<HTMLFormElement>('[data-guestbook-composer]');
	const field = document.querySelector<HTMLTextAreaElement>('[data-guestbook-field]');
	const cancel = document.querySelector<HTMLButtonElement>('[data-guestbook-cancel]');
	const toast = document.querySelector<HTMLElement>('[data-guestbook-toast]');

	if (layer && opener && composer && field && cancel) {
		/** A volume is the thing worth signing. The front page is a drawer, and
		 *  the chapters are somebody else's work inside their own frame. */
		const PAGE = location.pathname.replace(/\/+$/, '') || '/';
		const onVolume = /^\/vol\/[^/]+$/.test(PAGE);
		// Every earlier round is retired with its key. Those notes were kept in
		// this browser and were never anybody else's to read; there is no way to
		// send them on, and leaving them would show one reader a page nobody
		// else can see.
		['', 'v2:', 'v3:', 'v4:'].forEach((v) => {
			try {
				localStorage.removeItem(`vibe-fold:guestbook:${v}${PAGE}`);
			} catch {
				// Nothing to clear if storage is not there to begin with.
			}
		});

		/** The last time this browser left a note. The only thing still kept
		 *  here — it is about the hand holding the pen, not about the book. */
		const PACE = 'vibe-fold:guestbook:last';

		const tooSoon = () => {
			try {
				const last = Number(localStorage.getItem(PACE) || 0);
				return Date.now() - last < PAUSE;
			} catch {
				return false;
			}
		};

		const markPace = () => {
			try {
				localStorage.setItem(PACE, String(Date.now()));
			} catch {
				// Nothing to remember it with. One note at a time is not worth
				// refusing over.
			}
		};

		/** The band across the top belongs to the navigation, and a note dropped
		 *  against `innerWidth` lands past the right edge — that measure counts
		 *  the scrollbar. Both are the stickers' own rules. */
		const clearBand = () => {
			const probe = document.createElement('div');
			probe.style.cssText =
				'position:fixed;left:0;top:0;width:0;height:var(--stage-clear);visibility:hidden';
			document.body.appendChild(probe);
			const height = probe.getBoundingClientRect().height;
			probe.remove();
			return height;
		};

		const MARGIN = 16;

		const place = (note: HTMLElement) => {
			const page = document.documentElement.clientWidth;
			const band = clearBand();
			const width = note.offsetWidth;
			const height = note.offsetHeight;
			const left = MARGIN + Math.random() * Math.max(0, page - width - MARGIN * 2);
			const top =
				window.scrollY +
				band +
				MARGIN +
				Math.random() * Math.max(0, window.innerHeight - band - height - MARGIN * 2);
			return { left: Math.round(left), top: Math.round(top) };
		};

		/** `26.02.12 10:42 PM` — the reader's own clock at the moment the note was
		 *  left. Written out by hand rather than handed to a locale, so the shape
		 *  stays the same wherever the page is opened. */
		const clock = (at: number) => {
			const d = new Date(at);
			const pad = (n: number) => String(n).padStart(2, '0');
			const hour = d.getHours();
			const date = `${pad(d.getFullYear() % 100)}.${pad(d.getMonth() + 1)}.${pad(d.getDate())}`;
			const time = `${pad(hour % 12 || 12)}:${pad(d.getMinutes())} ${hour < 12 ? 'AM' : 'PM'}`;
			return `${date} ${time}`;
		};

		const nodes: HTMLElement[] = [];

		const drop = (note: Note) => {
			const placed = note as Placed;
			const el = document.createElement('div');
			el.className = 'gb-note';
			el.innerHTML = '<p class="gb-note__bubble"></p><span class="gb-note__time"></span>';
			el.querySelector('.gb-note__bubble')!.textContent = note.text;
			el.querySelector('.gb-note__time')!.textContent = clock(note.at);
			layer.appendChild(el);

			// Measured after it is in the document: where it lands depends on how
			// tall the sentence turned out.
			const spot = place(el);
			placed.x = spot.left;
			placed.y = spot.top;

			const page = document.documentElement.clientWidth;
			const x = Math.min(placed.x, Math.max(MARGIN, page - el.offsetWidth - MARGIN));
			el.style.left = `${Math.max(MARGIN, x)}px`;
			el.style.top = `${placed.y}px`;

			nodes.push(el);
			makeDraggable([el]);
			window.requestAnimationFrame(() => {
				el.dataset.shown = 'true';
			});
		};

		/** Not before the folder has opened.
		 *
		 *  Notes are placed against the window, and on a volume page the window
		 *  is busy: a folder flies in, grows and swings open over it. A note
		 *  dropped during that lands on a page whose measurements are still
		 *  changing, and it reads as litter thrown across the transition rather
		 *  than as something left on the paper.
		 *
		 *  The transition holds `data-opening` on the root for as long as it is
		 *  running. Arriving without one — a refresh, a bookmark — there is no
		 *  attribute and nothing to wait for. */
		const lay = async () => {
			opener.hidden = false;
			const written = await fetchNotes(PAGE, SHOWN);
			written.forEach(drop);
		};

		if (onVolume) {
			if (document.documentElement.dataset.opening === undefined) {
				lay();
			} else {
				const watcher = new MutationObserver(() => {
					if (document.documentElement.dataset.opening !== undefined) return;
					watcher.disconnect();
					window.clearTimeout(fallback);
					lay();
				});
				watcher.observe(document.documentElement, {
					attributes: true,
					attributeFilter: ['data-opening'],
				});

				// However the transition ends — finished, cut short, never started
				// because the frame clock never ran — the notes are laid out.
				const fallback = window.setTimeout(() => {
					watcher.disconnect();
					lay();
				}, 4000);
			}
		}

		let toastTimer = 0;

		/** What went wrong, said in the composer itself rather than anywhere the
		 *  writer has to go looking. */
		const complain = (what: string) => {
			if (!toast) return;
			toast.textContent = what;
			toast.hidden = false;
			window.clearTimeout(toastTimer);
			toastTimer = window.setTimeout(() => {
				toast.hidden = true;
			}, 2000);
		};

		const close = () => {
			composer.hidden = true;
			field.value = '';
			if (toast) toast.hidden = true;
		};

		const open = () => {
			composer.hidden = false;
			field.focus();
		};

		opener.addEventListener('click', open);

		field.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') close();
			// Enter finishes the note; a new line takes a modifier, as a chat field
			// works.
			if (event.key === 'Enter' && !event.shiftKey) {
				event.preventDefault();
				composer.requestSubmit();
			}
		});

		cancel.addEventListener('click', close);

		composer.addEventListener('submit', (event) => {
			event.preventDefault();

			const text = field.value.trim().slice(0, LIMIT);
			if (!text) {
				complain('내용을 입력해 주세요.');
				field.focus();
				return;
			}

			if (tooSoon()) {
				complain('방금 남기셨습니다. 잠시 뒤에 다시 남겨 주세요.');
				return;
			}

			// Put on the page at once, and sent on its way. The writer should see
			// their own note land whether or not the table is reachable — and if
			// it was not, the note stays for as long as they are here, which is
			// the honest version of what happened.
			drop({ id: `local-${Date.now()}`, text, at: Date.now() });
			markPace();
			close();

			postNote(PAGE, text);
		});
	}
</script>
