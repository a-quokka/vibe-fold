---
/** 홈에 흩뿌려 두는 작품들.
 *
 *  서랍은 닫힌 표지의 줄이라서, 안에 무엇이 들어 있는지 한마디도 하지
 *  않습니다. 들어온 사람이 폴더를 열어 봐야 비로소 작품이 있다는 사실을
 *  알게 되는데, 이 페이지가 해야 할 일은 보자마자 만들고 싶어지게 만드는
 *  것이므로 순서가 거꾸로입니다.
 *
 *  그래서 작품을 처음부터 꺼내 둡니다. 슬로건이 놓인 자리에 그림들을 흩어
 *  놓습니다.
 *
 *  그림 하나를 가리키면 그 그림이 앞으로 나오면서 어느 볼륨의 무슨
 *  작품인지 말합니다. 흩어 놓기만 하면 예쁜 무늬로 끝나고, 무엇을 보고
 *  있는지 알 수 없으면 만들고 싶어지지도 않습니다.
 */
import type { Volume } from '../lib/content';
import { chapterHref } from '../lib/content';

interface Props {
	volumes: Volume[];
}

const { volumes } = Astro.props;

/** 저장소에 있는 작품을 모두 꺼냅니다. 어느 볼륨에서 왔는지 함께 들고
 *  다녀야 가리켰을 때 그 이름을 말할 수 있습니다. */
const works = volumes.flatMap((volume) =>
	volume.chapters.map((chapter) => ({
		chapter,
		volume,
		/** 볼륨이 아직 나오지 않았다면 열어 볼 자리가 없습니다. 그때는 그림을
		 *  걸어 두기만 하고 어디로도 보내지 않습니다. */
		href: volume.status === 'published' ? chapterHref(volume.volId, chapter.chId) : null,
	})),
);

/** 자리를 하나하나 손으로 적는 대신 둥글게 흩습니다.
 *
 *  각도를 황금각으로 돌려 가며 놓으면 몇 점이든 고르게 퍼지고, 한가운데를
 *  비워 둘 수 있습니다. 가운데는 슬로건이 쓰는 자리입니다. 같은 번호에는
 *  언제나 같은 자리가 나오므로 새로고침해도 화면이 흔들리지 않습니다.
 */
const GOLDEN = 137.508;

function scatterAt(i: number, count: number) {
	const angle = ((i * GOLDEN) % 360) * (Math.PI / 180);
	// 안쪽 고리와 바깥쪽 고리를 번갈아 써서, 한 겹으로 늘어선 것처럼 보이지
	// 않게 합니다.
	const ring = 0.62 + (i % 3) * 0.14;
	const x = 50 + Math.cos(angle) * ring * 44;
	const y = 50 + Math.sin(angle) * ring * 46;
	// 그림마다 크기를 조금씩 달리해 눈이 한 점씩 따로 집어내게 합니다.
	const w = 10 + ((i * 7) % 5);
	return {
		x: Math.round(x * 10) / 10,
		y: Math.round(y * 10) / 10,
		w,
		// 떠다니는 폭과 방향, 그리고 한 바퀴 도는 데 걸리는 시간입니다.
		dx: ((i % 5) - 2) * 5,
		dy: (((i + 2) % 4) - 1.5) * 6,
		secs: 17 + ((i * 3) % 11),
		// 다 같이 움직이면 파도가 되고, 제각각이어야 떠 있는 것으로 보입니다.
		delay: -(i * 2.7),
		count,
	};
}

const placed = works.map((work, i) => ({ ...work, ...scatterAt(i, works.length) }));
---

<div class="scatter">
	{
		placed.map(({ chapter, volume, href, x, y, w, dx, dy, secs, delay }) => {
			const Tag = href ? 'a' : 'div';
			return (
				<Tag
					class="scatter__work"
					href={href ?? undefined}
					style={`--x:${x}%; --y:${y}%; --w:${w}%; --dx:${dx}px; --dy:${dy}px; --secs:${secs}s; --delay:${delay}s;`}
				>
					<img class="scatter__shot" src={chapter.thumbSrc} alt="" loading="lazy" draggable="false" />
					<span class="scatter__card">
						<span class="scatter__vol">{`Vol.${volume.number} ${volume.title}`}</span>
						<span class="scatter__name">{chapter.title}</span>
						<span class="scatter__desc">{chapter.description}</span>
					</span>
				</Tag>
			);
		})
	}
</div>

<style>
	/* 슬로건이 쓰는 상자에 겹쳐 둡니다. 페이지에 높이를 더하지 않으므로
	   아래의 서랍은 조금도 움직이지 않습니다. 위쪽은 머리글이 쓰는 높이만큼
	   비웁니다. */
	.scatter {
		position: absolute;
		inset: var(--h-header) 0 0;
		pointer-events: none;
	}

	.scatter__work {
		position: absolute;
		left: var(--x);
		top: var(--y);
		/* 제자리에서 천천히 떠다닙니다. 자리는 `left`·`top` 이 잡고, 흔들림은
		   `translate` 가 맡습니다. 둘을 나눠 두면 서로를 덮어쓰지 않습니다. */
		animation: drift var(--secs) ease-in-out var(--delay) infinite;
		will-change: translate;
	}

	.scatter__work {
		width: var(--w);
		/* 가리킬 수 있어야 합니다. 상자 전체는 포인터를 받지 않으므로 그림만
		   따로 받습니다. */
		pointer-events: auto;
		color: inherit;
		text-decoration: none;
		transition:
			scale 320ms var(--ease-out),
			filter 320ms var(--ease-out);
	}

	.scatter__shot {
		display: block;
		width: 100%;
		aspect-ratio: 16 / 10;
		object-fit: cover;
		object-position: center 30%;
		/* 그림의 가장자리가 어두운 바탕에 녹지 않도록 아주 옅은 테두리를
		   둡니다. 색을 띤 테두리는 그림 끝에 때가 낀 것처럼 보입니다. */
		outline: 1px solid oklch(1 0 0 / 0.1);
		outline-offset: -1px;
	}

	/* 가리킨 그림은 앞으로 나오고 커집니다. 떠다니던 것도 그 자리에 멈춰야
	   글을 읽을 수 있습니다. */
	.scatter__work:hover,
	.scatter__work:focus-visible {
		z-index: 3;
		scale: 1.75;
		animation-play-state: paused;
	}

	.scatter__work:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 4px;
	}

	/* 그림 위에 덮이는 설명입니다. 그림 밖으로 내보내면 가장자리에 놓인
	   그림에서는 화면을 벗어나므로, 언제나 그림 안에 담습니다. */
	.scatter__card {
		position: absolute;
		inset: auto 0 0;
		display: flex;
		flex-direction: column;
		gap: 0.15em;
		padding: 0.5em 0.6em;
		background: linear-gradient(to top, oklch(0 0 0 / 0.88), oklch(0 0 0 / 0.72) 62%, transparent);
		color: #fff;
		opacity: 0;
		transition: opacity 240ms var(--ease-out);
	}

	.scatter__work:hover .scatter__card,
	.scatter__work:focus-visible .scatter__card {
		opacity: 1;
	}

	/* 커진 그림 위에 얹히므로 글자는 아주 작게 둡니다. 1.75배로 부풀려진
	   뒤에야 읽을 만한 크기가 됩니다. */
	.scatter__vol {
		font-size: 0.34rem;
		letter-spacing: 0.08em;
		opacity: 0.75;
	}

	.scatter__name {
		font-size: 0.5rem;
		font-weight: 600;
		line-height: 1.2;
	}

	.scatter__desc {
		font-size: 0.34rem;
		line-height: 1.45;
		opacity: 0.82;
		/* 설명은 작품마다 길이가 달라서, 세 줄에서 끊어 그림을 다 덮지
		   않게 합니다. */
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	@keyframes drift {
		0%,
		100% {
			translate: 0 0;
		}
		33% {
			translate: var(--dx) var(--dy);
		}
		66% {
			translate: calc(var(--dx) * -0.7) calc(var(--dy) * 0.6);
		}
	}

	/* 좁은 화면에서는 글자가 상자를 거의 다 쓰기 때문에, 그림을 옅게 두어
	   슬로건을 읽을 수 있게 합니다. */
	@media (max-width: 40rem) {
		.scatter__work {
			opacity: 0.5;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.scatter__work {
			animation: none;
		}

		.scatter__work:hover,
		.scatter__work:focus-visible {
			scale: 1.5;
		}
	}
</style>
