---
import BrandMark from './BrandMark.astro';

interface Props {
	compact?: boolean;
	/** The home page states the tagline as its own slogan, so the header there
	 *  carries the wordmark alone rather than repeating it. */
	tagline?: boolean;
}

const { compact = false, tagline = true } = Astro.props;

/** Top navigation.
 *
 *  `href: undefined` means the destination does not exist on this site yet —
 *  those render as plain labels rather than as links that lead nowhere. Give an
 *  item a URL here and it becomes a link with no other change needed.
 */
const navItems: { label: string; href?: string; external?: boolean; section?: RegExp }[] = [
	/** The front page is the drawer, and the drawer is the work — so this is
	 *  where the site starts, and it stays lit the whole time the reader is
	 *  inside a volume. */
	{ label: 'Works', href: '/#featured', section: /^\/(vol\/.*)?$/ },
	{ label: 'About', href: 'https://vibecodingclub.kr/', external: true },
];

const here = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isCurrent(item: { href?: string; section?: RegExp }): boolean {
	if (item.section) return item.section.test(here);
	if (!item.href || item.href.startsWith('http')) return false;
	const target = item.href.split('#')[0].replace(/\/+$/, '') || '/';
	return target === here;
}
---

<header class:list={['site-header', { 'site-header--compact': compact }]} data-site-header>
	<div class="site-header__inner">
	<a class="brand" href="/">
		<BrandMark />
		<span class="visually-hidden">Vibe Fold</span>
		{tagline && (
			<span class="brand__tagline">We publish visual stories that move the world</span>
		)}
	</a>

	<nav class="site-nav" aria-label="Main">
		<ul class="site-nav__list">
			{
				navItems.map((item) => {
					const current = isCurrent(item);

					return (
						<li class="site-nav__item">
							{item.href ? (
								<a
									class:list={['site-nav__link', { 'site-nav__link--current': current }]}
									href={item.href}
									aria-current={current ? 'page' : undefined}
									rel={item.external ? 'noreferrer' : undefined}
								>
									{item.label}
								</a>
							) : (
								<span class="site-nav__link site-nav__link--pending">{item.label}</span>
							)}
						</li>
					);
				})
			}
		</ul>
	</nav>
	</div>
</header>

<style>
	/* Sits over the page rather than in the flow, so a full-bleed opening screen
	   runs edge to edge behind it. Pages reserve `--h-header` at the top. */
	/* The bar runs the full width — it is chrome, and chrome meets the edges of
	   the screen. What is held to the page's measure is what is written on it. */
	.site-header {
		position: fixed;
		inset: 0 0 auto;
		/* Above the page and everything dropped on it — the folders, the pinned
		   notes, the windows. The only things that come over the bar are the two
		   a visitor summons themselves: the selection callout and the guestbook
		   sheet. */
		z-index: 100;
		min-height: var(--h-header);
		/* 맨 위에 붙어 서 있다가, 페이지가 스크롤되면 위로 빠집니다.
		 *
		 *  머리글은 페이지의 머리에 얹힌 것이므로, 머리를 떠나면 함께
		 *  물러나는 것이 제자리입니다. 돌아오는 것은 다시 맨 위에 닿았을
		 *  때입니다 — 스크롤 방향을 따라 오가게 두면, 아래로 읽다가 손을
		 *  조금만 되돌려도 바가 끼어들어 읽던 자리를 가립니다. */
		translate: 0 0;
		transition-property: translate, background-color, box-shadow;
		transition-duration: 300ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.site-header[data-hidden='true'] {
		translate: 0 -100%;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header {
			transition-property: background-color, box-shadow;
		}

		/* 물러나지 않고 그대로 머뭅니다. 움직임을 줄이는 환경에서 화면 위의
		   것이 소리 없이 오가면, 그것은 절제가 아니라 사라지는 기능입니다. */
		.site-header[data-hidden='true'] {
			translate: 0 0;
		}
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		/* Wordmark alone on the leading edge, the menu gathered on the trailing
		   one — the two jobs read as two jobs. */
		justify-content: space-between;
		gap: clamp(1.25rem, 3vw, 2.75rem);
		min-height: var(--h-header);
		max-width: var(--w-max);
		margin-inline: auto;
		padding: 0 var(--page-pad);
	}

	/* At the top of a page the bar is nothing at all — the page opens on its own
	   content. Once anything has scrolled under it, it becomes the same glass
	   everything else that floats is made of, which is how a desktop toolbar
	   behaves and what tells you the page has moved. */
	.site-header[data-lifted='true'] {
		background: var(--glass-bg);
		/* No shadow at all. The material is the whole statement: the bar is
		   evidently in front because the page is blurred through it, and every
		   edge treatment on top of that — a rim, a sheen, a drop — reads as a box
		   drawn round the page. */
		box-shadow: none;
		backdrop-filter: var(--glass-blur);
		-webkit-backdrop-filter: var(--glass-blur);
	}



	.brand {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1.5rem;
		/* Colour is the static cue; opacity only softens the transition. */
		transition-property: opacity;
		transition-duration: 150ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	.brand:hover {
		opacity: 0.7;
	}

	.brand:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 0.375rem;
	}

	.brand__tagline {
		font-size: var(--text-meta);
		font-weight: 400;
		line-height: var(--lh-tight);
		color: var(--color-muted);
	}

	.site-nav__list {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-nav-gap);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* Set as a index rather than as a sentence: small, spaced out, in capitals.
	   Helvetica at body size and body weight is the most anonymous thing on a
	   screen — it is what a page looks like before anybody has set it. The face
	   is the same; what gives it a voice is the case, the tracking and the size
	   it is held at against the wordmark beside it. */
	.site-nav__link {
		display: inline-block;
		font-size: var(--text-nav);
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		line-height: var(--lh-tight);
		white-space: nowrap;
		color: var(--color-muted);
		transition-property: opacity, scale, color;
		transition-duration: 150ms;
		transition-timing-function: cubic-bezier(0.2, 0, 0, 1);
	}

	a.site-nav__link:hover {
		opacity: 0.6;
	}

	a.site-nav__link:active {
		scale: 0.96;
	}

	a.site-nav__link:focus-visible {
		outline: 2px solid var(--color-text);
		outline-offset: 0.25rem;
	}

	/* Current page. The reference fades it to 0.8, which is too slight to read
	   as a state; muted colour carries it, and `aria-current` states it outright. */
	.site-nav__link--current {
		color: var(--color-text);
		font-weight: 600;
	}

	a.site-nav__link--current:hover {
		opacity: 1;
	}

	/* No destination yet — reads as a label, not as a link that goes nowhere. */
	.site-nav__link--pending {
		color: var(--color-muted);
		cursor: default;
	}

	@media (max-width: 720px) {
		.site-header__inner {
			gap: 1rem;
		}

		.brand__tagline {
			display: none;
		}

		.site-nav__list {
			flex-wrap: nowrap;
			gap: 0.875rem;
			overflow-x: auto;
			scrollbar-width: none;
		}

		.site-nav__list::-webkit-scrollbar {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.site-header,
		.brand,
		.site-nav__link {
			transition: none;
		}
	}
</style>

<script>
	// 스크롤이 두 가지를 정합니다. 바가 무엇인가를 이고 있는지(어떤 재료로
	// 보일지), 그리고 페이지가 머리를 떠났는지(물러날지)입니다.
	//
	// 방향은 보지 않습니다. 오직 맨 위에 있는지만 봅니다 — 방향을 따라
	// 오가게 두면 아래로 읽다가 손을 조금 되돌릴 때마다 바가 끼어듭니다.
	// 움직임을 줄이는 환경에서는 물러나지 않습니다(CSS 가 잡아 둡니다).
	const header = document.querySelector<HTMLElement>('[data-site-header]');

	if (header) {
		let ticking = false;

		const update = () => {
			const y = window.scrollY;

			header.dataset.lifted = String(y > 8);

			/* 폴더가 날아가는 동안에는 물러나지 않습니다.
			 *
			 *  그 사이 바는 나가는 길이자, 다음 페이지에서도 같은 자리에 서
			 *  있어야 하는 유일한 요소입니다. 스크롤 값만 보고 숨기면, 폴더를
			 *  누른 순간 내려와 서 있던 바가 페이지가 바뀌기 직전에 다시
			 *  올라가 버립니다. 비행이 페이지를 떠날 때까지 잡아 둡니다. */
			if (document.documentElement.dataset.flight === 'true') {
				header.dataset.hidden = 'false';
				ticking = false;
				return;
			}

			// 제 높이만큼 밀려 들어갔을 때 물러납니다. 몇 픽셀에 반응하면
			// 손가락이 스치기만 해도 바가 튑니다.
			header.dataset.hidden = String(y > header.offsetHeight);

			ticking = false;
		};

		update();

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
	}
</script>
