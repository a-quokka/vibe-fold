		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		overflow: hidden;
		margin: 0;
		font-size: var(--text-meta);
		line-height: var(--lh-body);
		color: var(--color-card-muted);
