</style>

<script>
	const folders = Array.from(document.querySelectorAll<HTMLElement>('[data-folder]'));

	/** 탭이 줄 안에서 움직일 수 있는 폭을 재서 적어 둡니다.
	 *
	 *  줄 너비에서 탭 너비를 뺀 값입니다. 0 보다 작아지면 0 으로 둡니다 —
	 *  탭이 줄보다 넓은 화면에서는 어긋날 자리가 없으니 전부 왼쪽에 붙여
	 *  세우는 것이 맞고, 음수를 그대로 쓰면 탭이 줄 밖으로 밀려나 앞머리가
	 *  잘립니다.
	 *
	 *  글꼴이 도착하면 탭의 너비가 바뀌고, 화면 폭이 바뀌면 줄의 너비가
	 *  바뀝니다. 두 경우에 다시 잽니다. */
	const measureTabPlay = () => {
		folders.forEach((folder) => {
			const row = folder.querySelector<HTMLElement>('.folder__tabs');
			const tab = folder.querySelector<HTMLElement>('.tab');
			if (!row || !tab) return;
			const play = Math.max(0, Math.round(row.clientWidth - tab.offsetWidth));
			folder.style.setProperty('--tab-play', `${play}px`);
		});
	};

	measureTabPlay();
	if (document.fonts) document.fonts.ready.then(measureTabPlay);
	window.addEventListener('resize', measureTabPlay);

	const front = folders.length - 1;

	/** Opening folder k uncovers its band by shrinking every cover in front of
	 *  it — the indices greater than k. The frontmost folder keeps its own band
	 *  on show throughout: nothing covers its lower half, and in the reference
	 *  the opened category's copy and the front folder's are on screen together.
	 */
	const open = (index: number | null) => {
		folders.forEach((folder, i) => {
			folder.dataset.front = String(i === front);
			folder.dataset.open = String(i === index);
			folder.dataset.shifted = String(index !== null && i > index);
		});
	};

	// Nothing is open until the visitor asks: every folder rests shut.
	open(null);

	/** Hover runs in two stages, as the reference does.
	 *
	 *  Over the folder body the cover cracks open a sliver and the colour lifts —
	 *  enough to say "this one is live" without committing the screen to it.
	 *  Over the folder's own tab it opens the rest of the way and the summary
	 *  comes up. Clicking anywhere on the cover goes to the volume.
	 *
	 *  Pointer-gated: on touch a tap would otherwise peek and follow the link in
	 *  the same gesture. */
	const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
	const isMouse = (event: PointerEvent) =>
		finePointer.matches && event.pointerType === 'mouse';

	/** A cover never tilts alone. Whatever angle the hovered one takes, every
	 *  cover standing in front of it takes the same — that is what keeps their
	 *  edges parallel instead of one tapering against square neighbours. */
	const peek = (index: number | null) => {
		folders.forEach((folder, i) => {
			folder.dataset.peek = String(i === index);
			folder.dataset.peekShifted = String(index !== null && i > index);
		});
	};

	peek(null);

	/** How far the folders in front have to travel for folder `index` to show its
	 *  copy.
	 *
	 *  Where the copy ends, plus the margin the cover keeps on every side, less
	 *  the lip — the folder in front already stands one lip below this one, and
	 *  that head start is travel it does not have to make. Forgetting it left the
	 *  last two lines under the next folder.
	 *
	 *  Plus that folder's tab, which stands above its top edge: clearing the
	 *  folder is not clearing the folder, and the tab was sitting on the last
	 *  line of copy.
	 *
	 *  Layout offsets, not bounding rects: by the time a label is hovered the
	 *  covers are tilting, and rects measured through that rotation come back
	 *  shifted by the stack's own perspective.
	 */
	const revealDistance = (index: number): number => {
		const folder = folders[index];
		const next = folders[index + 1];
		const summary = folder?.querySelector<HTMLElement>('.folder__face');
		const last = summary?.querySelector<HTMLElement>('.folder__copy');
		if (!folder || !next) return 0;

		// 소개글이 없는 폴더는 드러낼 내용도 없습니다. 준비 중이라는 사실
		// 자체는 표지에 이미 적혀 있으므로 앞의 폴더를 밀어낼 이유가 없습니다.
		if (!summary || !last) return 0;

		const inset = summary.offsetLeft;
		const copyEnds = summary.offsetTop + last.offsetTop + last.offsetHeight;
		const lip = next.offsetTop - folder.offsetTop;
		const tab = next.querySelector<HTMLElement>('.tab')?.offsetHeight ?? 0;

		return Math.max(0, Math.round(copyEnds + inset - lip + tab));
	};

	/** The reference's text button. Pointing at folder k's label pushes every
	 *  folder in front of it down the stack until k's copy is in the open; the
	 *  fold carries on underneath, so a cover that was opening stays open.
	 *
	 *  The frontmost folder is exempt: its copy is on show already and there is
	 *  nothing standing in front of it to move.
	 */
	const reveal = (index: number | null) => {
		const distance = index === null ? 0 : revealDistance(index);

		/* 서랍 아래에 선 것들에게 얼마나 밀렸는지 알립니다. 지금은 페이지
		   발치가 이 값을 보고 같이 내려갑니다. 폴더만 내려가고 발치가 제자리에
		   있으면, 밀려난 폴더가 발치 위로 올라타 두 색면이 겹칩니다. */
		if (distance > 0) {
			document.documentElement.style.setProperty('--drawer-push', `${distance}px`);
		} else {
			document.documentElement.style.removeProperty('--drawer-push');
		}

		folders.forEach((folder, i) => {
			const pushed = index !== null && i > index;
			folder.dataset.revealed = String(index !== null && i === index);
			folder.dataset.pushed = String(pushed);

			if (pushed) {
				folder.style.setProperty('--folder-push', `${distance}px`);
			} else {
				folder.style.removeProperty('--folder-push');
			}
		});
	};

	reveal(null);

	folders.forEach((folder, index) => {
		folder.addEventListener('pointerenter', (event) => {
			if (!isMouse(event)) return;
			peek(index);
			// 가려진 폴더를 가리키면 그 앞에 선 폴더들이 내려가서 소개글이
			// 드러납니다. 예전에는 펼침 버튼에만 걸려 있었는데, 준비 중인
			// 폴더에는 그 버튼이 없기 때문에 소개글을 볼 방법이 없었습니다.
			// 맨 앞 폴더는 이미 제 소개글이 드러나 있고 앞에 밀어낼 폴더도
			// 없으므로 제외합니다.
			reveal(index < front ? index : null);
		});

		const button = folder.querySelector<HTMLElement>('[data-unfold]');

		const tab = folder.querySelector<HTMLElement>('.tab');
		tab?.addEventListener('pointerenter', (event) => {
			if (!isMouse(event)) return;
			open(index);
		});

		/* Hover opens a folder; a click anywhere on one goes to it, which the
		 * transition handles for the folder as a whole.
		 *
		 * Touch has no hover, so there the tab carries the reveal instead: tap to
		 * open the folder, tap again to close it. The cover still goes to the
		 * volume. */
		/** 눌렀을 때 열고 닫는 동작. 손가락으로 쓸 때만 붙습니다. */
		const toggle = () => {
			if (finePointer.matches) return;

			const showing = folder.dataset.open === 'true';
			if (showing) {
				open(null);
				reveal(null);
				return;
			}

			open(index);
			reveal(index < front ? index : null);
		};

		tab?.addEventListener('click', toggle);

		/* 아직 나오지 않은 볼륨은 표지를 눌러도 열고 닫습니다.
		 *
		 *  이 폴더에는 들어갈 페이지가 없어서 표지에 링크가 걸리지 않고,
		 *  손가락에는 얹는 동작이 없습니다. 그래서 반응이 탭 조각 하나에만
		 *  걸려 있었는데, 그 조각은 손가락으로 겨냥하기에 너무 좁아서 표지를
		 *  눌러도 아무 일이 없는 화면으로 보였습니다. 마우스로 얹었을 때
		 *  일어나는 일을 손가락으로는 눌렀을 때 일어나게 합니다.
		 *
		 *  나온 볼륨은 그대로 둡니다. 그쪽은 표지를 누르면 볼륨으로 넘어가는
		 *  것이 할 일이고, 여는 동작까지 겹치면 넘어가는 길이 막힙니다. */
		/* 누르고 있는 동안만 표시를 남깁니다. 손가락이 미끄러져 폴더를
		   벗어나거나 브라우저가 스크롤로 가로채 가면(`pointercancel`) 표시도
		   함께 지웁니다 — 누르지 않은 폴더가 눌린 채로 남으면 그것은 표시가
		   아니라 얼룩입니다. */
		folder.addEventListener('pointerdown', (event) => {
			if (isMouse(event)) return;
			folder.dataset.pressed = '';
		});

		['pointerup', 'pointercancel', 'pointerleave'].forEach((type) => {
			folder.addEventListener(type, () => {
				delete folder.dataset.pressed;
			});
		});

		const page = folder.querySelector<HTMLElement>('.folder__page');
		if (!page) {
			folder.addEventListener('click', (event) => {
				// 탭에서 온 눌림은 위에서 이미 처리했습니다. 여기서 한 번 더
				// 받으면 열자마자 닫힙니다.
				if ((event.target as HTMLElement | null)?.closest('.tab')) return;
				toggle();
			});
		}

		// Nothing in front of the frontmost folder to push, and its copy is
		// already in the open.
		if (button && index < front) {
			button.addEventListener('pointerenter', (event) => {
				if (!isMouse(event)) return;
				open(index);
				reveal(index);
			});

			button.addEventListener('pointerleave', (event) => {
				if (!isMouse(event)) return;
				reveal(null);
			});
		}


		// Keyboard users get the full reveal when focus lands inside a folder.
		// Keyboard: focus landing on the cover's link opens the folder it belongs to.
		folder.addEventListener('focusin', () => open(index));
	});

	// Leaving the stack settles back to the resting state.
	const stack = document.querySelector<HTMLElement>('.folder-stack');

	// On touch the same job falls to a tap anywhere else on the page.
	document.addEventListener('click', (event) => {
		if (finePointer.matches) return;
		if (stack?.contains(event.target as Node)) return;
		open(null);
		reveal(null);
	});
	stack?.addEventListener('pointerleave', (event) => {
		if (!isMouse(event)) return;
		peek(null);
		open(null);
		reveal(null);
	});

</script>
