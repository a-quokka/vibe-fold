		width: var(--text-folder-label);
		height: var(--text-folder-label);
		rotate: -90deg;
		transition-property: rotate;
		transition-duration: var(--folder-duration);
		transition-timing-function: var(--folder-ease);
	}

	/* Points down only while the copy is actually out — it is the state of the
	   reveal, not of the fold. */
	.folder[data-revealed='true'] .folder__chevron {
		rotate: 0deg;
	}

	/* The summary is printed on the cover's face, which is why the reference
	   only has to tilt it 3deg: what uncovers the copy is the covers in front
	   retreating, not this one swinging out of the way. */

	/* The scatter surface. Cards are absolutely placed so dragging one never
	   reflows the others. */
	.collage {
		position: relative;
		flex: 1 1 auto;
		min-height: 0;
		/* Pointer Events drive the drag; this stops the browser panning the page
		   out from under a touch drag. */
		touch-action: none;
	}

	.work {
		position: absolute;
		top: var(--y0);
		left: var(--x0);
		display: flex;
		flex-direction: column;
		width: min(15rem, 68%);
		translate: var(--x, 0px) var(--y, 0px);
		rotate: var(--tilt);
		background: var(--color-card);
		color: var(--color-card-text);
		border-radius: 0.25rem;
