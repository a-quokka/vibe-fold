	.folder__when {
		margin: 0;
		font-size: var(--text-meta);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		opacity: 0.6;
	}

	/* 표지에서 가장 먼저 읽히는 것. 레퍼런스의 제목만큼 크게 둡니다. */
	.folder__name {
		margin-top: 0;
		font-size: clamp(1.6rem, 3.8vw, 3.1rem);
		font-weight: 500;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	/* 제목 아래 한 줄. 표지는 읽는 자리가 아니라 고르는 자리이므로, 소개글
	   전체가 아니라 첫 문단만 작게 싣습니다. */
	.folder__blurb {
		margin-top: 0;
		font-size: var(--text-body);
		line-height: var(--lh-body);
		opacity: 0.78;
	}

	/* 한 문장이 한 줄입니다. 폭을 재어 접는 대신 문장이 끝나는 자리에서
	   바꿉니다. 문장 하나가 칸보다 길면 그때는 브라우저가 접습니다 — 그런
	   문장은 표지에 싣기에 이미 긴 것이므로, 접히는 편이 잘리는 편보다
	   낫습니다. */
	.folder__blurb span {
		display: block;
	}

	/* 오른쪽의 그림 한 장.
	 *
	 *  그림틀은 그림의 비율을 따릅니다. 4:3 으로 세워 두었을 때는 가로가 긴
	 *  그림이 들어오면서 좌우가 잘렸습니다. ARTWORK.md 가 정한 썸네일 규격이
	 *  3:2 ~ 16:10 이므로 그 가장 긴 쪽에 맞춰 둡니다. */
	.folder__shot {
		grid-column: 2;
		/* 두 줄을 가로질러 표지의 맨 위에서 시작합니다. 둘째 줄에만 두었을
		   때는 첫 줄이 남긴 높이만큼 내려와 앉아, 글의 윗선과 어긋났습니다. */
		grid-row: 1 / -1;
		/* 표지의 오른쪽 위 모서리에 붙입니다. 가운데에 띄워 두었을 때는 글과
		   그림의 윗선이 어긋나 표지가 두 덩어리로 읽혔습니다. */
		/* 높이는 표지가 남긴 만큼 끝까지 채우고, 폭만 못 박습니다. 비율을
		   정해 두던 것을 걷었으므로 가로로 긴 그림은 위아래가 잘립니다. */
		align-self: stretch;
		justify-self: end;
		width: var(--folder-shot-w);
		min-height: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		border-radius: 6px;
		background: oklch(0 0 0 / 0.07);
	}

	.folder__shot img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/* 아직 작품이 없는 볼륨의 자리입니다. */
	.folder__empty {
		font-size: var(--text-meta);
		letter-spacing: 0.14em;
		opacity: 0.45;
	}

	/* 좁은 화면에서는 그림을 내리고 글만 남깁니다. 둘을 나란히 두기에는
